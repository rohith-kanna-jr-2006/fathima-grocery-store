<div class="flex items-center justify-between mb-md">
<div class="p-sm bg-on-surface-variant/10 rounded-lg text-on-surface-variant">
<span class="material-symbols-outlined" style="font-variation-settings: 'FILL' 1;">local_shipping</span>
</div>
<span class="text-on-surface-variant font-label-sm text-label-sm">Active</span>
</div>
<p class="text-on-surface-variant font-label-md text-label-md">Active Suppliers</p>
<h3 class="text-headline-md font-headline-md text-on-surface" id="inventorySuppliersCount">0</h3>
</div>
</div>
<!-- INVENTORY TABLE CONTAINER -->
<div class="bg-white rounded-xl border border-outline-variant/30 shadow-[0px_4px_20px_rgba(30,41,59,0.05)] overflow-hidden">
<div class="overflow-x-auto">
<table class="w-full text-left border-collapse">
<thead>
<tr class="bg-surface-container-lowest border-b border-outline-variant/20">
<th class="px-lg py-md font-label-md text-label-md text-on-surface-variant uppercase tracking-wider">Product</th>
<th class="px-lg py-md font-label-md text-label-md text-on-surface-variant uppercase tracking-wider">Category</th>
<th class="px-lg py-md font-label-md text-label-md text-on-surface-variant uppercase tracking-wider">Barcode</th>
<th class="px-lg py-md font-label-md text-label-md text-on-surface-variant uppercase tracking-wider text-center">Stock</th>
<th class="px-lg py-md font-label-md text-label-md text-on-surface-variant uppercase tracking-wider">Purchase Price</th>
<th class="px-lg py-md font-label-md text-label-md text-on-surface-variant uppercase tracking-wider">Selling Price</th>
<th class="px-lg py-md font-label-md text-label-md text-on-surface-variant uppercase tracking-wider">Status</th>
<th class="px-lg py-md font-label-md text-label-md text-on-surface-variant uppercase tracking-wider text-right">Action</th>
</tr>
</thead>
<tbody class="divide-y divide-outline-variant/10" id="inventoryTableBody">
<!-- Loaded dynamically -->
</tbody>
</table>
</div>
<!-- TABLE FOOTER / PAGINATION -->
<div class="px-lg py-md flex items-center justify-between border-t border-outline-variant/20 bg-surface-container-lowest">
<p class="text-body-sm text-body-sm text-on-surface-variant" id="tablePaginationText">Showing 0-0 of 0 products</p>
<div class="flex items-center gap-sm" id="tablePaginationControls">
<!-- Dynamic controls -->
</div>
</div>
</div>
</div>
</main>
<!-- FLOATING QUICK ACTIONS (FAB) -->
<button onclick="window.location.href='/products/add'" class="fixed bottom-margin-desktop right-margin-desktop w-14 h-14 bg-primary text-white rounded-full shadow-2xl flex items-center justify-center hover:scale-105 active:scale-95 transition-all z-50 group">
<span class="material-symbols-outlined text-[28px]">add</span>
<span class="absolute right-full mr-4 px-3 py-1.5 bg-inverse-surface text-inverse-on-surface rounded-lg text-sm whitespace-nowrap opacity-0 group-hover:opacity-100 transition-opacity pointer-events-none">Add Product</span>
</button>
<script>
        let inventoryList = [];
        let filterMode = 'all'; // 'all' or 'out'
        let inventoryPage = 1;
        const inventoryLimit = 8;

        // Fetch dashboard stats for KPI cards
        async function loadKPIs() {
            const token = localStorage.getItem('token');
            try {
                const res = await fetch('/api/dashboard/stats', {
                    headers: { 'Authorization': `Bearer ${token}` }
                });
                const data = await res.json();
                if (data.success) {
                    const stats = data.data.cards;
                    document.getElementById('inventoryTotalSKU').textContent = stats.totalProducts;
                    document.getElementById('inventoryLowStock').textContent = stats.lowStockCount;
                    document.getElementById('inventoryTotalValue').textContent = formatCurrency(stats.inventoryValue);
                    
                    // Suppliers count
                    const supRes = await fetch('/api/suppliers', {
                        headers: { 'Authorization': `Bearer ${token}` }
                    });
                    const supData = await supRes.json();
                    if (supData.success) {
                        document.getElementById('inventorySuppliersCount').textContent = supData.data.length;
                    }
                }
            } catch (err) {
                console.error(err);
            }
        }

        // Fetch Inventory
        async function loadInventory(page = 1) {
            inventoryPage = page;
            const token = localStorage.getItem('token');
            const search = document.getElementById('inventorySearch').value.trim();
            
            let url = `/api/inventory?page=${page}&limit=${inventoryLimit}`;
            if (search) url += `&search=${encodeURIComponent(search)}`;
            if (filterMode === 'out') url += `&status=Out of Stock`;

            try {
                const res = await fetch(url, {
                    headers: { 'Authorization': `Bearer ${token}` }
                });
                const data = await res.json();
                if (data.success) {
                    renderInventoryTable(data.data);
                    renderPagination(data.pagination);
                }
            } catch (err) {
                console.error(err);
                showToast('Failed to load inventory.', 'error');
            }
        }

        function renderInventoryTable(items) {
            const tbody = document.getElementById('inventoryTableBody');
            if (items.length === 0) {
                tbody.innerHTML = `<tr><td colspan="8" class="px-lg py-md text-center italic text-on-surface-variant">No stock records found.</td></tr>`;
                return;
            }

            tbody.innerHTML = items.map(item => {
                const p = item.product || {};
                const qty = item.stockQuantity;
                const status = item.status;
                const img = p.image || 'https://images.unsplash.com/photo-1542838132-92c53300491e?auto=format&fit=crop&w=200&q=80';

                // Stock progress math (assume max 500 stock level)
                const percent = Math.min(Math.round((qty / 500) * 100), 100);

                let badgeClass = 'bg-primary-container/20 text-primary';
                let progressColor = 'bg-primary';
                let dotColor = 'bg-primary';

                if (status === 'Out of Stock') {
                    badgeClass = 'bg-error-container/20 text-error';
                    progressColor = 'bg-error';
                    dotColor = 'bg-error';
                } else if (status === 'Low Stock') {
                    badgeClass = 'bg-secondary-container/20 text-secondary';
                    progressColor = 'bg-secondary';
                    dotColor = 'bg-secondary';
                }

                return `
                    <tr class="hover:bg-surface-container-low transition-colors group">
                        <td class="px-lg py-md">
                            <div class="flex items-center gap-md">
                                <div class="w-12 h-12 rounded-lg bg-surface-container-highest flex-shrink-0 overflow-hidden">
                                    <img class="w-full h-full object-cover" src="${img}" alt="${p.name || 'Product'}"/>
                                </div>
                                <div>
                                    <p class="font-label-md text-label-md text-on-surface">${p.name || 'Unknown Product'}</p>
                                    <p class="text-body-sm text-body-sm text-on-surface-variant">${p.brand || 'General'}</p>
                                </div>
                            </div>
                        </td>
                        <td class="px-lg py-md">
                            <span class="px-sm py-1 bg-surface-container-high rounded text-[11px] font-bold text-on-surface-variant uppercase">${p.category ? (p.category.name || 'Staples') : 'General'}</span>
                        </td>
                        <td class="px-lg py-md text-body-sm font-body-sm text-on-surface-variant font-mono">${p.barcode || 'N/A'}</td>
                        <td class="px-lg py-md text-center">
                            <div class="flex flex-col items-center gap-xs">
                                <span class="font-label-md text-label-md ${status === 'Out of Stock' ? 'text-error font-bold' : 'text-on-surface'}">${qty}</span>
                                <div class="w-20 h-1.5 bg-surface-container rounded-full overflow-hidden">
                                    <div class="${progressColor} h-full rounded-full" style="width: ${percent}%"></div>
                                </div>
                            </div>
                        </td>
                        <td class="px-lg py-md font-label-md text-label-md text-on-surface">${formatCurrency(p.purchasePrice || 0)}</td>
                        <td class="px-lg py-md font-label-md text-label-md text-on-surface">${formatCurrency(p.sellingPrice || 0)}</td>
                        <td class="px-lg py-md">
                            <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-[12px] font-bold ${badgeClass}">
                                <span class="w-1.5 h-1.5 rounded-full ${dotColor}"></span>
                                ${status}
                            </span>
                        </td>
                        <td class="px-lg py-md text-right">
                            <div class="flex justify-end gap-sm">
                                <button onclick="window.location.href='/stock-adjustment?product=${p._id}'" class="p-1 hover:text-primary" title="Quick Adjust"><span class="material-symbols-outlined text-[20px]">tune</span></button>
                                <button onclick="window.location.href='/products/edit/${p._id}'" class="p-1 hover:text-primary" title="Edit details"><span class="material-symbols-outlined text-[20px]">edit</span></button>
                            </div>
                        </td>
                    </tr>
                `;
            }).join('');
        }

        function renderPagination(p) {
            const paginationText = document.getElementById('tablePaginationText');
            const controls = document.getElementById('tablePaginationControls');

            const startIdx = (p.page - 1) * p.limit + 1;
            const endIdx = Math.min(p.page * p.limit, p.total);
            
            paginationText.textContent = `Showing ${p.total > 0 ? startIdx : 0}-${endIdx} of ${p.total} products`;

            let controlsHtml = `
                <button class="w-10 h-10 flex items-center justify-center rounded-lg border border-outline-variant hover:bg-surface-container transition-colors disabled:opacity-50" ${p.page === 1 ? 'disabled' : ''} onclick="loadInventory(${p.page - 1})">
                    <span class="material-symbols-outlined">chevron_left</span>
                </button>
                <div class="flex items-center">
            `;

            for (let i = 1; i <= p.pages; i++) {
                if (i === 1 || i === p.pages || (i >= p.page - 1 && i <= p.page + 1)) {
                    const activeClass = i === p.page ? 'bg-primary text-white' : 'text-on-surface-variant hover:bg-surface-container';
                    controlsHtml += `<button class="w-10 h-10 flex items-center justify-center rounded-lg font-label-md ${activeClass}" onclick="loadInventory(${i})">${i}</button>`;
                } else if (i === 2 || i === p.pages - 1) {
                    controlsHtml += `<span class="px-2 text-on-surface-variant">...</span>`;
                }
            }

            controlsHtml += `
                </div>
                <button class="w-10 h-10 flex items-center justify-center rounded-lg border border-outline-variant hover:bg-surface-container transition-colors disabled:opacity-50" ${p.page === p.pages ? 'disabled' : ''} onclick="loadInventory(${p.page + 1})">
                    <span class="material-symbols-outlined">chevron_right</span>
                </button>
            `;
            controls.innerHTML = controlsHtml;
        }

        // Toggle stock views
        document.getElementById('allStockBtn').addEventListener('click', () => {
            filterMode = 'all';
            document.getElementById('allStockBtn').className = 'px-md py-sm bg-white shadow-sm rounded-lg text-primary font-label-md text-label-md';
            document.getElementById('outStockBtn').className = 'px-md py-sm text-on-surface-variant font-label-md text-label-md hover:text-on-surface';
            loadInventory(1);
        });

        document.getElementById('outStockBtn').addEventListener('click', () => {
            filterMode = 'out';
            document.getElementById('outStockBtn').className = 'px-md py-sm bg-white shadow-sm rounded-lg text-primary font-label-md text-label-md';
            document.getElementById('allStockBtn').className = 'px-md py-sm text-on-surface-variant font-label-md text-label-md hover:text-on-surface';
            loadInventory(1);
        });

        // Search Input
        document.getElementById('inventorySearch').addEventListener('input', () => loadInventory(1));

        // Start
        window.addEventListener('load', () => {
            loadKPIs();
            loadInventory(1);
        });
    </script>
</body></html>
</body></html>
</file>

