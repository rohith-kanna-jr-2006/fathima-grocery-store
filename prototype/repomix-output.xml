<span class="text-[10px] text-outline font-bold uppercase">Current Stock</span>
<div class="flex items-center gap-xs">
<span class="material-symbols-outlined text-primary text-sm">inventory</span>
<span class="font-label-md" id="preview-stock">0 pcs</span>
</div>
</div>
<div class="flex flex-col">
<span class="text-[10px] text-outline font-bold uppercase">Status</span>
<div class="flex items-center gap-xs">
<span id="previewStatusIndicator" class="w-2 h-2 rounded-full bg-error animate-pulse"></span>
<span class="font-label-md text-error" id="previewStatusText">Out of Stock</span>
</div>
</div>
</div>
<div class="flex flex-col gap-sm">
<div class="flex justify-between items-center">
<span class="text-xs text-on-surface-variant font-medium">SKU</span>
<span class="text-xs font-mono font-bold" id="preview-sku">SKU-0000</span>
</div>
<div class="flex justify-between items-center">
<span class="text-xs text-on-surface-variant font-medium">Supplier</span>
<span class="text-xs font-bold" id="preview-supplier">Not Selected</span>
</div>
<div class="flex justify-between items-center">
<span class="text-xs text-on-surface-variant font-medium">Location</span>
<span class="text-xs font-bold" id="preview-location">Unassigned</span>
</div>
</div>
<div class="mt-md p-md bg-surface-container rounded-lg">
<p class="text-xs text-on-surface-variant italic leading-relaxed" id="preview-desc">
                                "Enter a description on the left to see it reflected here in the product summary."
                            </p>
</div>
</div>
</div>
<div class="mt-lg p-lg glass-panel rounded-xl flex items-center gap-md">
<div class="w-10 h-10 rounded-full bg-primary/10 flex items-center justify-center text-primary">
<span class="material-symbols-outlined">help</span>
</div>
<div>
<p class="text-sm font-bold text-on-surface">Need help?</p>
<p class="text-xs text-on-surface-variant">View our <a class="text-primary underline" href="#">Product Setup Guide</a></p>
</div>
</div>
