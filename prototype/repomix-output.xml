<script>
        async function loadCategories() {
            const token = localStorage.getItem('token');
            try {
                const res = await fetch('/api/categories', { headers: { 'Authorization': `Bearer ${token}` } });
                const data = await res.json();
                if (data.success) {
                    document.getElementById('filterCategory').innerHTML = '<option value="">All Categories</option>' +
                        data.data.map(c => `<option value="${c.name}">${c.name}</option>`).join('');
                }
            } catch(e) {
                console.error(e);
            }
        }

        async function loadStockReport() {
            const token = localStorage.getItem('token');
            const status = document.getElementById('filterStockStatus').value;
            const category = document.getElementById('filterCategory').value;

            try {
                const res = await fetch('/api/reports/stock', { headers: { 'Authorization': `Bearer ${token}` } });
                const data = await res.json();
                if (data.success) {
                    renderStockReport(data.summary, data.data, status, category);
                }
            } catch(e) {
                console.error(e);
            }
        }

        function renderStockReport(summary, data, statusFilter, categoryFilter) {
            let lowStock = data.lowStock || [];
            let expiringSoon = data.expiringSoon || [];

            // Fetch general stock statuses
            // We can also compute low stock count
            document.getElementById('kpiLowStock').textContent = summary.lowStockCount + ' Items';
            document.getElementById('kpiOutOfStock').textContent = lowStock.filter(item => item.status === 'Out of Stock').length + ' Items';
            document.getElementById('kpiSlowMoving').textContent = summary.expiringSoonCount + ' Items';

            // Populate table body with low stock products
            const tbody = document.getElementById('stockStatusTableBody');
            let tableData = lowStock;
            if (categoryFilter) {
                tableData = tableData.filter(item => item.category && item.category.toLowerCase() === categoryFilter.toLowerCase());
            }
            if (statusFilter) {
                tableData = tableData.filter(item => item.status === statusFilter);
            }

            if (tableData.length === 0) {
                tbody.innerHTML = `<tr><td colspan="6" class="px-lg py-md text-center italic text-on-surface-variant text-sm">No items matching criteria.</td></tr>`;
            } else {
                tbody.innerHTML = tableData.map(item => {
                    const statusClass = item.status === 'Low Stock' 
                        ? 'bg-tertiary/10 text-tertiary' 
                        : 'bg-error/10 text-error';

                    return `
                        <tr class="hover:bg-surface-container-low/50 transition-colors">
                            <td class="px-lg py-md">
                                <div class="flex items-center gap-md">
                                    <div class="w-10 h-10 rounded-lg bg-surface-container flex items-center justify-center text-outline"><span class="material-symbols-outlined">inventory</span></div>
                                    <div>
                                        <p class="font-label-md text-label-md text-on-surface">${item.name}</p>
                                        <p class="font-body-sm text-body-sm text-on-surface-variant">SKU: ${item.barcode || 'N/A'}</p>
                                    </div>
                                </div>
                            </td>
                            <td class="px-lg py-md font-body-sm text-body-sm">${item.category || 'General'}</td>
                            <td class="px-lg py-md font-body-sm text-body-sm text-center font-bold text-error">${item.stockQuantity} units</td>
                            <td class="px-lg py-md font-body-sm text-body-sm text-center">15 units</td>
                            <td class="px-lg py-md">
                                <span class="px-md py-base ${statusClass} rounded-full font-label-sm text-label-sm">${item.status}</span>
                            </td>
                            <td class="px-lg py-md font-body-md text-body-md text-right font-semibold text-primary">+50 units</td>
                        </tr>
                    `;
                }).join('');
            }

            // Populate restock suggestions
            const suggestionsList = document.getElementById('restockSuggestionsList');
            if (lowStock.length === 0) {
                suggestionsList.innerHTML = `<p class="p-md text-center italic text-on-surface-variant text-xs">All inventory stocks are healthy!</p>`;
            } else {
                suggestionsList.innerHTML = lowStock.map(item => `
                    <div class="flex items-center gap-md p-md bg-surface-container-lowest rounded-xl border border-outline-variant">
                        <div class="w-12 h-12 bg-primary-fixed/20 rounded-lg flex items-center justify-center text-primary">
                            <span class="material-symbols-outlined">shopping_basket</span>
                        </div>
                        <div class="flex-1">
                            <p class="font-label-md text-label-md text-on-surface">${item.name}</p>
                            <p class="font-body-sm text-body-sm text-error">Current: ${item.stockQuantity} units</p>
                        </div>
                        <button onclick="window.location.href='/purchase/new'" class="material-symbols-outlined text-primary hover:bg-primary/10 p-sm rounded-full transition-colors">shopping_cart</button>
                    </div>
                `).join('');
            }
        }

        window.addEventListener('load', () => {
            loadCategories();
            loadStockReport();
        });
    </script>
</body></html>
