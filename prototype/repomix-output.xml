<!-- Global Action Buttons -->
<div class="mt-2xl flex items-center justify-between bg-surface-container-low p-lg rounded-2xl border border-outline-variant/30">
<div class="flex items-center gap-md">
<button onclick="window.location.href='/sales'" class="px-lg py-md rounded-xl font-label-md text-label-md text-on-surface-variant hover:bg-surface-container-high transition-all flex items-center gap-sm">
