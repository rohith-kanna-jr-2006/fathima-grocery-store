<script>
        let loadedSuppliers = [];
        let loadedProducts = [];

        // Set Date to Today
        document.getElementById('purchaseDate').value = new Date().toISOString().split('T')[0];
        
        // Generate random Purchase ID
        const purchaseIdStr = `PUR-${Date.now().toString().slice(-6)}`;
        document.getElementById('purchaseId').value = purchaseIdStr;
        document.getElementById('invoiceNumber').value = `PINV-${Date.now().toString().slice(-4)}`;

        // Fetch suppliers and products
        async function loadFormData() {
            const token = localStorage.getItem('token');
            try {
                // Fetch suppliers
                const supRes = await fetch('/api/suppliers?limit=100', {
                    headers: { 'Authorization': `Bearer ${token}` }
                });
                const supData = await supRes.json();
                if (supData.success) {
                    loadedSuppliers = supData.data;
                    const select = document.getElementById('supplierSelect');
                    select.innerHTML = loadedSuppliers.map(s => `<option value="${s._id}">${s.name}</option>`).join('');
                    
                    // Trigger initial supplier details
                    if (loadedSuppliers.length > 0) {
                        document.getElementById('supplierContact').value = loadedSuppliers[0].phone || '+91 00000 00000';
                    }
                }

                // Fetch products
                const prodRes = await fetch('/api/products?limit=200', {
                    headers: { 'Authorization': `Bearer ${token}` }
                });
                const prodData = await prodRes.json();
                if (prodData.success) {
                    loadedProducts = prodData.data;
                    const select = document.getElementById('productSelect');
                    select.innerHTML = loadedProducts.map(p => `<option value="${p._id}">${p.name}</option>`).join('');
                    
                    // Trigger initial product details
                    if (loadedProducts.length > 0) {
                        selectProductDetails(loadedProducts[0]);
                    }
                }
            } catch (err) {
                console.error(err);
                showToast('Failed to load supplier/product metadata.', 'error');
            }
        }

        function selectProductDetails(p) {
            document.getElementById('productCategory').value = p.category ? (p.category.name || p.category) : 'General';
            document.getElementById('purchaseUnit').value = p.unit || 'pcs';
            document.getElementById('unitPrice').value = p.purchasePrice || 0;
            updateTotals();
        }

        // Supplier Selection change listener
        document.getElementById('supplierSelect').addEventListener('change', (e) => {
            const supplierId = e.target.value;
            const supplier = loadedSuppliers.find(s => s._id === supplierId);
            if (supplier) {
                document.getElementById('supplierContact').value = supplier.phone || '+91 00000 00000';
            }
        });

        // Product Selection change listener
        document.getElementById('productSelect').addEventListener('change', (e) => {
            const productId = e.target.value;
            const product = loadedProducts.find(p => p._id === productId);
            if (product) {
                selectProductDetails(product);
            }
        });

        // Calculate pricing
        function updateTotals() {
            const qty = parseFloat(document.getElementById('purchaseQty').value) || 0;
            const unitPrice = parseFloat(document.getElementById('unitPrice').value) || 0;
            const rawCost = qty * unitPrice;
            document.getElementById('totalCost').value = formatCurrency(rawCost);

            const gstPercent = parseFloat(document.getElementById('gstPercent').value) || 0;
            const gstAmount = rawCost * (gstPercent / 100);
            
            const discount = parseFloat(document.getElementById('discountAmount').value) || 0;
            const grandTotal = rawCost + gstAmount - discount;

            // Update label
            document.getElementById('gstLabel').textContent = `GST (${gstPercent}%)`;

            // Populate summary side card
            document.getElementById('summarySubtotal').textContent = formatCurrency(rawCost);
            document.getElementById('summaryGst').textContent = formatCurrency(gstAmount);
            document.getElementById('summaryDiscount').textContent = `- ${formatCurrency(discount)}`;
            document.getElementById('summaryGrandTotal').textContent = formatCurrency(grandTotal);

            // Summary info text
            const prodSelect = document.getElementById('productSelect');
            const selectedText = prodSelect.options[prodSelect.selectedIndex]?.text || 'items';
            document.getElementById('summaryInfoText').textContent = `Inventory stock will increase by ${qty} unit(s) for "${selectedText}".`;
        }

        // Bind calculation listeners
        document.getElementById('purchaseQty').addEventListener('input', updateTotals);
        document.getElementById('unitPrice').addEventListener('input', updateTotals);
        document.getElementById('gstPercent').addEventListener('input', updateTotals);
        document.getElementById('discountAmount').addEventListener('input', updateTotals);

        // Submit recorded restock purchase
        async function submitPurchase() {
            const token = localStorage.getItem('token');
            const supplierId = document.getElementById('supplierSelect').value;
            const invoiceNumber = document.getElementById('invoiceNumber').value.trim();
            const productId = document.getElementById('productSelect').value;
            const quantity = parseFloat(document.getElementById('purchaseQty').value) || 0;
            const purchaseCost = parseFloat(document.getElementById('unitPrice').value) || 0;
            const paymentStatus = document.getElementById('paymentStatus').value;

            if (!supplierId) {
                showToast('Please select a supplier.', 'error');
                return;
            }
            if (!invoiceNumber) {
                showToast('Please enter supplier invoice number.', 'error');
                return;
            }
            if (!productId) {
                showToast('Please select a product to restock.', 'error');
                return;
            }
            if (quantity <= 0) {
                showToast('Quantity must be greater than zero.', 'error');
                return;
            }
            if (purchaseCost <= 0) {
                showToast('Purchase price cost must be greater than zero.', 'error');
                return;
            }

            const body = {
                supplierId,
                invoiceNumber,
                paymentStatus,
                products: [
                    {
                        productId,
                        quantity,
                        purchaseCost
                    }
                ]
            };

            try {
                const res = await fetch('/api/purchases', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'Authorization': `Bearer ${token}`
                    },
                    body: JSON.stringify(body)
                });
                const data = await res.json();
                if (data.success) {
                    showToast('Purchase logged and stock replenished!', 'success');
                    setTimeout(() => {
                        window.location.href = '/purchase';
                    }, 1200);
                } else {
                    showToast(data.message || 'Failed to record purchase.', 'error');
                }
            } catch (err) {
                showToast('Network error, failed to record purchase.', 'error');
            }
        }

        window.resetPurchaseForm = function() {
            document.getElementById('invoiceNumber').value = `PINV-${Date.now().toString().slice(-4)}`;
            document.getElementById('purchaseQty').value = 1;
            if (loadedProducts.length > 0) {
                selectProductDetails(loadedProducts[0]);
            }
        };

        window.addEventListener('load', loadFormData);
    </script>
</body></html>
</body></html>
</file>

