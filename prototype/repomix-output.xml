<!-- Stat Card 4 -->
<div class="bg-surface-container-lowest p-lg rounded-xl border border-outline-variant/20 shadow-sm flex items-center gap-lg">
<div class="w-12 h-12 rounded-full bg-tertiary-container/20 flex items-center justify-center text-on-tertiary-container">
<span class="material-symbols-outlined" style="font-variation-settings: 'FILL' 1;">account_balance_wallet</span>
</div>
<div>
<p class="text-headline-sm font-bold text-on-surface" id="statInventoryValue">₹0.00</p>
<p class="text-body-sm text-on-surface-variant">Inventory Value</p>
</div>
