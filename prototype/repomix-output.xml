<script>
        async function loadProfitLossData() {
            const token = localStorage.getItem('token');
            try {
                const res = await fetch('/api/profit-loss', {
                    headers: { 'Authorization': `Bearer ${token}` }
                });
                const data = await res.json();
                if (data.success) {
                    const stats = data.data;
                    
                    const revenue = stats.summary.revenue || 0;
                    const procurement = stats.summary.purchaseCost || 0;
                    const operating = stats.summary.expenses || 24000;
                    const totalExpenses = procurement + operating;
                    const netProfit = stats.summary.netProfit || (revenue - totalExpenses);
                    const grossMargin = revenue > 0 ? ((netProfit / revenue) * 100).toFixed(1) : '0.0';

                    // Update DOM cards
                    document.getElementById('kpiTotalRevenue').textContent = formatCurrency(revenue);
                    document.getElementById('kpiTotalExpenses').textContent = formatCurrency(totalExpenses);
                    document.getElementById('kpiNetProfit').textContent = formatCurrency(netProfit);
                    document.getElementById('kpiGrossMargin').textContent = `${grossMargin}%`;

                    // Update Expense Breakdown details
                    document.getElementById('expenseProcurement').textContent = formatCurrency(procurement);
                    document.getElementById('expensesDonutCenterText').textContent = formatCurrency(totalExpenses);

                    // Render Monthly trend graphs
                    const charts = stats.charts || [];
                    const maxVal = Math.max(...charts.map(c => Math.max(c.revenue, c.purchases)), 100);
                    
                    const chartContainer = document.getElementById('monthlyProfitTrendBars');
                    chartContainer.innerHTML = charts.map(c => {
                        const revPct = Math.round((c.revenue / maxVal) * 100);
                        const purPct = Math.round((c.purchases / maxVal) * 100);

                        return `
                            <div class="flex-1 flex flex-col items-center h-full justify-end">
                                <div class="w-full flex gap-[2px] items-end justify-center h-48 px-1">
                                    <div class="bg-primary w-4 rounded-t-sm" style="height: ${revPct}%" title="Revenue: ₹${c.revenue}"></div>
                                    <div class="bg-secondary w-4 rounded-t-sm" style="height: ${purPct}%" title="Procurement: ₹${c.purchases}"></div>
                                </div>
                                <span class="mt-sm font-label-sm text-label-sm text-on-surface-variant">${c.month}</span>
                            </div>
                        `;
                    }).join('');
                }
            } catch(e) {
                console.error(e);
            }
        }

        // Fetch Recent Transactions
        async function loadRecentLedger() {
            const token = localStorage.getItem('token');
            try {
                // Fetch recent sales and purchases
                const [salesRes, purchasesRes] = await Promise.all([
                    fetch('/api/sales?limit=5', { headers: { 'Authorization': `Bearer ${token}` } }),
                    fetch('/api/purchases?limit=5', { headers: { 'Authorization': `Bearer ${token}` } })
                ]);

                const salesData = await salesRes.json();
                const purchasesData = await purchasesRes.json();

                let ledger = [];

                if (salesData.success) {
                    salesData.data.forEach(s => {
                        ledger.push({
                            date: new Date(s.createdAt),
                            type: 'Revenue',
                            desc: `Store Sale - Invoice #${s.invoiceNumber || 'INV-0000'}`,
                            amount: s.totalAmount,
                            status: 'Verified'
                        });
                    });
                }

                if (purchasesData.success) {
                    purchasesData.data.forEach(p => {
                        ledger.push({
                            date: new Date(p.createdAt),
                            type: 'Expense',
                            desc: `Procurement - Supplier: ${p.supplier ? p.supplier.name : 'Stock replenishing'}`,
                            amount: -p.grandTotal,
                            status: 'Verified'
                        });
                    });
                }

                // Add operational expense mock
                ledger.push({
                    date: new Date(),
                    type: 'Expense',
                    desc: 'Operational Expenses (Rent, utilities, staff wages)',
                    amount: -24000,
                    status: 'Pending'
                });

                // Sort ledger entries by date descending
                ledger.sort((a,b) => b.date - a.date);

                const tbody = document.getElementById('ledgerTableBody');
                tbody.innerHTML = ledger.slice(0, 7).map(item => {
                    const dateStr = item.date.toLocaleDateString();
                    const isRev = item.type === 'Revenue';
                    const color = isRev ? 'text-primary' : 'text-error';
                    const prefix = isRev ? '+' : '';
                    
                    const badgeClass = isRev 
                        ? 'bg-primary-fixed/20 text-on-primary-fixed-variant' 
                        : 'bg-secondary-fixed/30 text-on-secondary-fixed-variant';

                    const statusClass = item.status === 'Verified' ? 'text-primary' : 'text-secondary';
                    const icon = item.status === 'Verified' ? 'check_circle' : 'schedule';

                    return `
                        <tr class="hover:bg-surface-container transition-colors">
                            <td class="px-lg py-md font-body-sm">${dateStr}</td>
                            <td class="px-lg py-md">
                                <span class="${badgeClass} px-sm py-1 rounded-full font-label-sm text-label-sm">${item.type}</span>
                            </td>
                            <td class="px-lg py-md font-body-sm">${item.desc}</td>
                            <td class="px-lg py-md text-right font-label-md ${color}">${prefix}${formatCurrency(item.amount)}</td>
                            <td class="px-lg py-md">
                                <span class="flex items-center gap-xs font-label-sm text-label-sm ${statusClass}">
                                    <span class="material-symbols-outlined text-[16px]" style="font-variation-settings: 'FILL' 1;">${icon}</span> ${item.status}
                                </span>
                            </td>
                        </tr>
                    `;
                }).join('');
            } catch (err) {
                console.error(err);
            }
        }

        window.addEventListener('load', () => {
            loadProfitLossData();
            loadRecentLedger();
        });

        // Simple hover effect for cards
        document.querySelectorAll('.bg-surface-container-lowest').forEach(card => {
            card.addEventListener('mouseenter', () => {
                card.classList.add('translate-y-[-2px]');
            });
            card.addEventListener('mouseleave', () => {
                card.classList.remove('translate-y-[-2px]');
            });
        });
    </script>
</body></html>
</body></html>
