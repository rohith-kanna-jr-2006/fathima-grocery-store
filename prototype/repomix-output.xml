<script>
        async function loadProfitReport() {
            const token = localStorage.getItem('token');
            const range = document.getElementById('filterDateRange').value;

            // Dates
            const endDate = new Date().toISOString().split('T')[0];
            const start = new Date();
            start.setDate(start.getDate() - parseInt(range));
            const startDate = start.toISOString().split('T')[0];

            const url = `/api/reports/profit?startDate=${startDate}&endDate=${endDate}`;

            try {
                const res = await fetch(url, { headers: { 'Authorization': `Bearer ${token}` } });
                const data = await res.json();
                if (data.success) {
                    renderProfitReport(data.summary, data.data);
                }
            } catch(e) {
                console.error(e);
            }
        }

        function renderProfitReport(summary, data) {
            const revenue = summary.revenue || 0;
            const netProfit = summary.netProfit || 0;
            const expenses = data[0] ? data[0].expenses : 24000;
            const cogs = data[0] ? data[0].cogs : (revenue * 0.62);

            // Update KPI cards
            document.getElementById('kpiRevenue').textContent = formatCurrency(revenue);
            document.getElementById('kpiExpenses').textContent = formatCurrency(cogs);
            document.getElementById('kpiProfit').textContent = formatCurrency(revenue - cogs);
            
            const grossMargin = revenue > 0 ? (((revenue - cogs) / revenue) * 100) : 0;
            document.getElementById('kpiMargin').textContent = grossMargin.toFixed(1) + '%';

            // Render table row breakdown
            const tbody = document.getElementById('financialTableBody');
            const now = new Date();
            const months = ['January', 'February', 'March', 'April', 'May', 'June', 'July', 'August', 'September', 'October', 'November', 'December'];
            const currentMonthName = months[now.getMonth()] + ' ' + now.getFullYear();

            tbody.innerHTML = `
                <tr class="hover:bg-surface-container-low transition-colors group">
                    <td class="px-lg py-md font-label-md text-label-md">${currentMonthName}</td>
                    <td class="px-lg py-md text-right font-body-sm text-body-sm">${formatCurrency(revenue)}</td>
                    <td class="px-lg py-md text-right font-body-sm text-body-sm">${formatCurrency(cogs)}</td>
                    <td class="px-lg py-md text-right font-body-sm text-body-sm">${formatCurrency(expenses)}</td>
                    <td class="px-lg py-md text-right font-body-md text-body-md font-semibold text-primary">${formatCurrency(revenue - cogs - expenses)}</td>
                    <td class="px-lg py-md text-center">
                        <span class="bg-primary/10 text-primary px-md py-xs rounded-full font-label-sm text-label-sm">
                            ${(revenue - cogs - expenses) >= 0 ? 'Profitable' : 'Loss'}
                        </span>
                    </td>
                </tr>
            `;
        }

        window.addEventListener('load', () => {
            loadProfitReport();
        });

        // Simple hover effect
        document.querySelectorAll('.bg-white.rounded-xl.shadow-sm').forEach(card => {
            card.addEventListener('mouseenter', () => {
                card.style.transform = 'translateY(-2px)';
                card.style.transition = 'transform 0.2s ease';
            });
            card.addEventListener('mouseleave', () => {
                card.style.transform = 'translateY(0)';
            });
        });
    </script>
</body></html>
</file>

