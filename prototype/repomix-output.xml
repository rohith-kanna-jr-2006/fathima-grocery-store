<script>
        // Load categories dynamically into dropdown
        async function loadCategories() {
            const token = localStorage.getItem('token');
            try {
                const res = await fetch('/api/categories', {
                    headers: { 'Authorization': `Bearer ${token}` }
                });
                const data = await res.json();
                if (data.success) {
                    const select = document.getElementById('filterCategory');
                    select.innerHTML = '<option value="">All Categories</option>' +
                        data.data.map(c => `<option value="${c.name}">${c.name}</option>`).join('');
                }
            } catch(e) {
                console.error(e);
            }
        }

        async function loadSalesReport() {
            const token = localStorage.getItem('token');
            const range = document.getElementById('filterDateRange').value;
            const category = document.getElementById('filterCategory').value;
            const paymentMethod = document.getElementById('filterPaymentMethod').value;

            // Calculate dates
            const endDate = new Date().toISOString().split('T')[0];
            const start = new Date();
            start.setDate(start.getDate() - parseInt(range));
            const startDate = start.toISOString().split('T')[0];

            let url = `/api/reports/sales?startDate=${startDate}&endDate=${endDate}`;
            if (category) url += `&category=${encodeURIComponent(category)}`;

            try {
                const res = await fetch(url, {
                    headers: { 'Authorization': `Bearer ${token}` }
                });
                const data = await res.json();
                if (data.success) {
                    renderSalesReport(data.summary, data.data, paymentMethod);
                }
            } catch(e) {
                console.error(e);
            }
        }

        function renderSalesReport(summary, sales, paymentFilter) {
            // Apply payment method filter locally if selected
            let filteredSales = sales;
            if (paymentFilter) {
                filteredSales = sales.filter(s => s.paymentMethod === paymentFilter);
            }

            // Calculate Period Revenue & Today's Sales
            const todayStr = new Date().toDateString();
            const todaySales = filteredSales
                .filter(s => new Date(s.date || s.createdAt).toDateString() === todayStr)
                .reduce((sum, s) => sum + s.grandTotal, 0);

            const periodRevenue = filteredSales.reduce((sum, s) => sum + s.grandTotal, 0);
            const count = filteredSales.length;
            const avgOrderVal = count > 0 ? (periodRevenue / count) : 0;

            // Update KPI cards
            document.getElementById('todaySalesText').textContent = formatCurrency(todaySales);
            document.getElementById('weeklyRevenueText').textContent = formatCurrency(periodRevenue);
            document.getElementById('avgOrderValueText').textContent = formatCurrency(avgOrderVal);
            document.getElementById('totalInvoicesText').textContent = count;

            // Render Invoice Table
            const tbody = document.getElementById('invoiceHistoryTableBody');
            if (filteredSales.length === 0) {
                tbody.innerHTML = `<tr><td colspan="7" class="px-lg py-md text-center italic text-on-surface-variant text-sm">No transaction records found matching filters.</td></tr>`;
            } else {
                tbody.innerHTML = filteredSales.map(s => {
                    const dateStr = new Date(s.date || s.createdAt).toLocaleString();
                    const statusColor = s.status === 'Completed' ? 'text-primary' : 'text-secondary';
                    const bulletColor = s.status === 'Completed' ? 'bg-primary' : 'bg-secondary';
                    const containerClass = s.status === 'Completed' ? 'bg-primary-container/20' : 'bg-secondary-container/20';

                    return `
                        <tr class="hover:bg-surface-container-low transition-colors group">
                            <td class="px-lg py-md font-medium text-primary">#INV-${s.invoiceNumber || '0000'}</td>
                            <td class="px-lg py-md text-sm text-on-surface-variant">${dateStr}</td>
                            <td class="px-lg py-md text-sm font-medium">${s.customer || 'Walk-in Customer'}</td>
                            <td class="px-lg py-md text-right text-sm font-bold">${formatCurrency(s.grandTotal)}</td>
                            <td class="px-lg py-md"><span class="px-2 py-1 bg-surface-container rounded-full text-[10px] font-bold uppercase">${s.paymentMethod || 'Cash'}</span></td>
                            <td class="px-lg py-md">
                                <span class="inline-flex items-center gap-1 px-2 py-0.5 ${containerClass} ${statusColor} text-[10px] font-bold rounded-full">
                                    <span class="w-1.5 h-1.5 rounded-full ${bulletColor}"></span> ${s.status || 'Completed'}
                                </span>
                            </td>
                            <td class="px-lg py-md text-center">
                                <button onclick="window.location.href='/sales'" class="opacity-0 group-hover:opacity-100 transition-opacity text-outline hover:text-primary">
                                    <span class="material-symbols-outlined text-[18px]">visibility</span>
                                </button>
                            </td>
                        </tr>
                    `;
                }).join('');
            }

            // Aggregate Product velocities
            const productsMap = {};
            filteredSales.forEach(s => {
                s.products.forEach(p => {
                    if (p.product) {
                        const name = p.product.name;
                        const qty = p.quantity;
                        const price = p.sellingPrice || (p.product.sellingPrice || 0);
                        if (!productsMap[name]) {
                            productsMap[name] = { name, qty: 0, rev: 0 };
                        }
                        productsMap[name].qty += qty;
                        productsMap[name].rev += qty * price;
                    }
                });
            });

            const sortedProducts = Object.values(productsMap).sort((a, b) => b.qty - a.qty);
            
            // Render Top Selling
            const topBody = document.getElementById('topSellingProductsBody');
            const top3 = sortedProducts.slice(0, 3);
            if (top3.length === 0) {
                topBody.innerHTML = `<tr><td colspan="3" class="py-md text-center italic text-on-surface-variant text-xs">No product sales logged.</td></tr>`;
            } else {
                topBody.innerHTML = top3.map(p => `
                    <tr class="hover:bg-surface-container-low transition-colors">
                        <td class="py-md text-sm font-medium">${p.name}</td>
                        <td class="py-md text-sm text-right">${p.qty}</td>
                        <td class="py-md text-sm text-right font-bold">${formatCurrency(p.rev)}</td>
                    </tr>
                `).join('');
            }

            // Render Low Velocity
            const lowBody = document.getElementById('lowVelocityProductsBody');
            const low3 = sortedProducts.reverse().slice(0, 3);
            if (low3.length === 0) {
                lowBody.innerHTML = `<tr><td colspan="3" class="py-md text-center italic text-on-surface-variant text-xs">No low velocity products.</td></tr>`;
            } else {
                lowBody.innerHTML = low3.map(p => `
                    <tr class="hover:bg-surface-container-low transition-colors">
                        <td class="py-md text-sm font-medium">${p.name}</td>
                        <td class="py-md text-sm text-right">${p.qty}</td>
                        <td class="py-md text-sm text-right font-bold">${formatCurrency(p.rev)}</td>
                    </tr>
                `).join('');
            }
        }

        window.addEventListener('load', () => {
            loadCategories();
            loadSalesReport();
        });

        // Micro-interactions and effects
        document.querySelectorAll('button, a').forEach(elem => {
            elem.addEventListener('mousedown', () => {
                elem.style.transform = 'scale(0.98)';
            });
            elem.addEventListener('mouseup', () => {
                elem.style.transform = '';
            });
            elem.addEventListener('mouseleave', () => {
                elem.style.transform = '';
            });
        });
    </script>
</body></html>
