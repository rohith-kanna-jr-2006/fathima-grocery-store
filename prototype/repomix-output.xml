<script>
        async function loadCategories() {
            const token = localStorage.getItem('token');
            try {
                const res = await fetch('/api/categories', {
                    headers: { 'Authorization': `Bearer ${token}` }
                });
                const data = await res.json();
                if (data.success) {
                    document.getElementById('filterCategory').innerHTML = '<option value="">All Categories</option>' +
                        data.data.map(c => `<option value="${c.name}">${c.name}</option>`).join('');
                }
            } catch(e) {
                console.error(e);
            }
        }

        async function loadInventoryReport() {
            const token = localStorage.getItem('token');
            const category = document.getElementById('filterCategory').value;
            const status = document.getElementById('filterStockStatus').value;

            let url = '/api/reports/inventory';
            const params = [];
            if (category) params.push(`category=${encodeURIComponent(category)}`);
            if (params.length > 0) url += `?${params.join('&')}`;

            try {
                const res = await fetch(url, { headers: { 'Authorization': `Bearer ${token}` } });
                const data = await res.json();
                if (data.success) {
                    renderInventoryReport(data.summary, data.data, status);
                }
            } catch(e) {
                console.error(e);
            }
        }

        function renderInventoryReport(summary, data, statusFilter) {
            let filtered = data;
            if (statusFilter) {
                filtered = data.filter(d => d.status === statusFilter);
            }

            // Update KPI cards
            document.getElementById('kpiTotalSku').textContent = filtered.length;
            
            const totalVal = filtered.reduce((sum, d) => sum + (d.stockQuantity * d.purchasePrice), 0);
            const lowStockCount = filtered.filter(d => d.status === 'Low Stock').length;
            const outOfStockCount = filtered.filter(d => d.status === 'Out of Stock').length;

            document.getElementById('kpiInventoryValue').textContent = formatCurrency(totalVal);
            document.getElementById('kpiLowStock').textContent = lowStockCount;
            document.getElementById('kpiOutOfStock').textContent = outOfStockCount;

            // Render table
            const tbody = document.getElementById('inventoryHistoryBody');
            if (filtered.length === 0) {
                tbody.innerHTML = `<tr><td colspan="6" class="px-lg py-md text-center italic text-on-surface-variant text-sm">No inventory records found.</td></tr>`;
            } else {
                tbody.innerHTML = filtered.map(d => {
                    const badgeClass = d.status === 'In Stock' 
                        ? 'bg-primary/10 text-primary' 
                        : (d.status === 'Low Stock' ? 'bg-tertiary/10 text-tertiary' : 'bg-error/10 text-error');

                    const imageStyle = d.image 
                        ? `background-image: url('${d.image}')` 
                        : '';
                    const imageMarkup = d.image 
                        ? `<div class="w-10 h-10 rounded bg-cover bg-center border border-outline-variant/20" style="${imageStyle}"></div>`
                        : `<div class="w-10 h-10 rounded bg-surface-container flex items-center justify-center text-outline"><span class="material-symbols-outlined text-sm">image</span></div>`;

                    return `
                        <tr class="hover:bg-primary/5 transition-colors group">
                            <td class="px-lg py-md">
                                <div class="flex items-center gap-sm">
                                    ${imageMarkup}
                                    <div>
                                        <p class="font-label-md text-label-md">${d.name}</p>
                                        <p class="text-[10px] text-on-surface-variant">${d.category || 'General'}</p>
                                    </div>
                                </div>
                            </td>
                            <td class="px-lg py-md text-body-sm font-mono">${d.barcode || 'N/A'}</td>
                            <td class="px-lg py-md">
                                <span class="${badgeClass} px-2 py-1 rounded-full text-xs font-bold">${d.stockQuantity} ${d.unit || 'Units'}</span>
                            </td>
                            <td class="px-lg py-md font-label-md">${formatCurrency(d.stockQuantity * d.purchasePrice)}</td>
                            <td class="px-lg py-md">
                                <div class="flex items-center gap-1 text-primary">
                                    <span class="text-xs">${d.status}</span>
                                </div>
                            </td>
                            <td class="px-lg py-md text-right">
                                <button onclick="window.location.href='/inventory'" class="opacity-0 group-hover:opacity-100 transition-opacity p-2 hover:bg-surface-container-high rounded-full">
                                    <span class="material-symbols-outlined text-on-surface-variant text-[18px]">visibility</span>
                                </button>
                            </td>
                        </tr>
                    `;
                }).join('');
            }

            // Render expiring soon warnings
            const expiringSoonList = document.getElementById('expiringSoonList');
            const expiring = filtered.filter(d => {
                if (!d.expiryDate) return false;
                const diff = new Date(d.expiryDate) - new Date();
                const days = Math.ceil(diff / (1000 * 60 * 60 * 24));
                return days > 0 && days <= 30;
            });

            if (expiring.length === 0) {
                expiringSoonList.innerHTML = `<p class="p-md text-center italic text-on-surface-variant text-xs">No items expiring in the next 30 days.</p>`;
            } else {
                expiringSoonList.innerHTML = expiring.map(d => {
                    const diff = new Date(d.expiryDate) - new Date();
                    const days = Math.max(1, Math.ceil(diff / (1000 * 60 * 60 * 24)));
                    const progress = Math.max(10, Math.round((days / 30) * 100));
                    const progressColor = days <= 5 ? 'bg-error' : 'bg-tertiary';
                    const listBg = days <= 5 ? 'bg-error/5 border-error/10' : 'bg-surface-container-low border-outline-variant';

                    return `
                        <div class="p-md rounded-lg ${listBg} border hover:border-primary transition-colors">
                            <p class="font-label-md text-label-md">${d.name}</p>
                            <div class="flex justify-between items-center mt-1">
                                <span class="text-xs text-on-surface-variant">Expires in ${days} days</span>
                                <span class="text-xs font-bold ${days <= 5 ? 'text-error' : 'text-tertiary'}">${d.stockQuantity} units</span>
                            </div>
                            <div class="mt-2 w-full h-1 bg-surface-container rounded-full">
                                <div class="${progressColor} h-full rounded-full" style="width: ${progress}%"></div>
                            </div>
                        </div>
                    `;
                }).join('');
            }
        }

        window.addEventListener('load', () => {
            loadCategories();
            loadInventoryReport();
        });

        // Simple hover effect
        document.querySelectorAll('.glass-card').forEach(card => {
            card.addEventListener('mouseenter', () => {
                card.style.transform = 'translateY(-2px)';
                card.style.transition = 'all 0.2s ease';
            });
            card.addEventListener('mouseleave', () => {
                card.style.transform = 'translateY(0)';
            });
        });
    </script>
</body></html>
