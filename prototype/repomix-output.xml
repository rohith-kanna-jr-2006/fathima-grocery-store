<script>
        // Load categories and suppliers dynamically into filters
        async function loadFilters() {
            const token = localStorage.getItem('token');
            try {
                // Categories
                const catRes = await fetch('/api/categories', { headers: { 'Authorization': `Bearer ${token}` } });
                const catData = await catRes.json();
                if (catData.success) {
                    document.getElementById('filterCategory').innerHTML = '<option value="">All Categories</option>' + 
                        catData.data.map(c => `<option value="${c.name}">${c.name}</option>`).join('');
                }

                // Suppliers
                const supRes = await fetch('/api/suppliers', { headers: { 'Authorization': `Bearer ${token}` } });
                const supData = await supRes.json();
                if (supData.success) {
                    document.getElementById('filterSupplier').innerHTML = '<option value="">All Suppliers</option>' + 
                        supData.data.map(s => `<option value="${s._id}">${s.name}</option>`).join('');
                }
            } catch(e) {
                console.error(e);
            }
        }

        async function loadPurchaseReport() {
            const token = localStorage.getItem('token');
            const range = document.getElementById('filterDateRange').value;
            const supplier = document.getElementById('filterSupplier').value;
            const category = document.getElementById('filterCategory').value;

            // Dates
            const endDate = new Date().toISOString().split('T')[0];
            const start = new Date();
            start.setDate(start.getDate() - parseInt(range));
            const startDate = start.toISOString().split('T')[0];

            let url = `/api/reports/purchase?startDate=${startDate}&endDate=${endDate}`;
            if (supplier) url += `&supplier=${encodeURIComponent(supplier)}`;

            try {
                const res = await fetch(url, { headers: { 'Authorization': `Bearer ${token}` } });
                const data = await res.json();
                if (data.success) {
                    renderPurchaseReport(data.summary, data.data, category);
                }
            } catch(e) {
                console.error(e);
            }
        }

        function renderPurchaseReport(summary, purchases, categoryFilter) {
            let filtered = purchases;
            if (categoryFilter) {
                // Filter purchase records by product category name
                filtered = purchases.filter(p => {
                    return p.products.some(item => {
                        return item.product && item.product.category && 
                               (item.product.category.name === categoryFilter || item.product.category === categoryFilter);
                    });
                });
            }

            const totalCost = filtered.reduce((sum, p) => sum + p.grandTotal, 0);
            const totalOrders = filtered.length;
            const totalItemsBought = filtered.reduce((sum, p) => sum + p.products.reduce((acc, item) => acc + item.quantity, 0), 0);

            // Get unique active suppliers count
            const supplierIds = new Set(filtered.map(p => p.supplier && (p.supplier._id || p.supplier)).filter(Boolean));

            // Update KPI cards
            document.getElementById('kpiTotalPurchases').textContent = totalOrders;
            document.getElementById('kpiMonthlySpending').textContent = formatCurrency(totalCost);
            document.getElementById('kpiActiveSuppliers').textContent = supplierIds.size;
            document.getElementById('kpiTotalItemsBought').textContent = totalItemsBought;

            // Render table body
            const tbody = document.getElementById('purchasesTableBody');
            if (filtered.length === 0) {
                tbody.innerHTML = `<tr><td colspan="7" class="px-lg py-md text-center italic text-on-surface-variant text-sm">No procurement orders found.</td></tr>`;
            } else {
                tbody.innerHTML = filtered.map(p => {
                    const dateStr = new Date(p.date || p.createdAt).toLocaleDateString();
                    const supplierName = p.supplier ? p.supplier.name : 'Stock Restock';
                    const categoryLabel = p.products[0] && p.products[0].product && p.products[0].product.category 
                        ? (p.products[0].product.category.name || 'General') 
                        : 'General';

                    const statusClass = p.paymentStatus === 'Paid' 
                        ? 'bg-primary-container/20 text-primary' 
                        : 'bg-secondary-container/20 text-secondary';
                    const bulletClass = p.paymentStatus === 'Paid' ? 'bg-primary' : 'bg-secondary';

                    return `
                        <tr class="hover:bg-surface-container/30 transition-colors group">
                            <td class="px-lg py-md font-label-md text-primary">#PO-${p.invoiceNumber || '0000'}</td>
                            <td class="px-lg py-md text-body-sm">${dateStr}</td>
                            <td class="px-lg py-md text-body-sm font-medium">${supplierName}</td>
                            <td class="px-lg py-md"><span class="px-sm py-xs bg-surface-container rounded text-[10px] uppercase font-bold">${categoryLabel}</span></td>
                            <td class="px-lg py-md font-bold text-on-surface">${formatCurrency(p.grandTotal)}</td>
                            <td class="px-lg py-md">
                                <span class="inline-flex items-center gap-xs px-sm py-xs rounded-full ${statusClass} text-[10px] font-bold">
                                    <span class="w-1.5 h-1.5 rounded-full ${bulletClass}"></span> ${p.paymentStatus || 'Paid'}
                                </span>
                            </td>
                            <td class="px-lg py-md text-right">
                                <button onclick="window.location.href='/purchase'" class="opacity-0 group-hover:opacity-100 transition-opacity text-on-surface-variant hover:text-primary">
                                    <span class="material-symbols-outlined text-[18px]">visibility</span>
                                </button>
                            </td>
                        </tr>
                    `;
                }).join('');
            }
        }

        window.addEventListener('load', () => {
            loadFilters();
            loadPurchaseReport();
        });

        // Simple micro-interaction for active scaling
        document.querySelectorAll('button, a').forEach(el => {
            el.addEventListener('mousedown', () => el.classList.add('scale-95'));
            el.addEventListener('mouseup', () => el.classList.remove('scale-95'));
            el.addEventListener('mouseleave', () => el.classList.remove('scale-95'));
        });
    </script>
</body></html>
