  <div class="p-lg border-b border-outline-variant flex flex-col md:flex-row justify-between items-center gap-md">
  <h3 class="font-headline-sm text-headline-sm">Existing Categories</h3>
  <div class="flex items-center gap-sm">
  <div class="relative">
  <span class="absolute left-3 top-1/2 -translate-y-1/2 material-symbols-outlined text-outline text-sm">search</span>
  <input id="tableSearchInput" class="pl-9 pr-4 py-1.5 bg-surface border border-outline-variant rounded-lg text-sm w-48 focus:w-64 transition-all focus:ring-primary focus:border-primary" placeholder="Search categories..." type="text"/>
  </div>
