<script>
        async function loadSuppliersFilter() {
            const token = localStorage.getItem('token');
            try {
                const res = await fetch('/api/suppliers', { headers: { 'Authorization': `Bearer ${token}` } });
                const data = await res.json();
                if (data.success) {
                    document.getElementById('filterSupplier').innerHTML = '<option value="">All Suppliers</option>' + 
                        data.data.map(s => `<option value="${s.name}">${s.name}</option>`).join('');
                }
            } catch(e) {
                console.error(e);
            }
        }

        async function loadSupplierReport() {
            const token = localStorage.getItem('token');
            const supplierFilter = document.getElementById('filterSupplier').value;

            try {
                const res = await fetch('/api/reports/supplier', { headers: { 'Authorization': `Bearer ${token}` } });
                const data = await res.json();
                if (data.success) {
                    renderSupplierReport(data.summary, data.data, supplierFilter);
                }
            } catch(e) {
                console.error(e);
            }
        }

        function renderSupplierReport(summary, reportData, supplierFilter) {
            let filtered = reportData;
            if (supplierFilter) {
                filtered = reportData.filter(r => r.name.toLowerCase().includes(supplierFilter.toLowerCase()));
            }

            // Update KPIs
            document.getElementById('kpiTotalSuppliers').textContent = filtered.length;
            const totalSpend = filtered.reduce((sum, r) => sum + r.totalSpent, 0);
            document.getElementById('kpiTotalSpend').textContent = formatCurrency(totalSpend);

            // Render table body
            const tbody = document.getElementById('supplierPerformanceTableBody');
            if (filtered.length === 0) {
                tbody.innerHTML = `<tr><td colspan="7" class="px-lg py-md text-center italic text-on-surface-variant text-sm">No supplier performance logs.</td></tr>`;
            } else {
                tbody.innerHTML = filtered.map(r => {
                    const stars = `<div class="flex text-tertiary">
                        <span class="material-symbols-outlined text-sm" style="font-variation-settings: 'FILL' 1;">star</span>
                        <span class="material-symbols-outlined text-sm" style="font-variation-settings: 'FILL' 1;">star</span>
