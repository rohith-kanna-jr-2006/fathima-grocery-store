<script>
        let purchasesPage = 1;
        const purchasesLimit = 10;

        // Fetch supplier filters
        async function loadFiltersMetadata() {
            const token = localStorage.getItem('token');
            try {
                const res = await fetch('/api/suppliers?limit=100', {
                    headers: { 'Authorization': `Bearer ${token}` }
                });
                const data = await res.json();
                if (data.success) {
                    const supSelect = document.getElementById('supplierFilterSelect');
                    supSelect.innerHTML = `<option value="">All Suppliers</option>` + 
                        data.data.map(s => `<option value="${s._id}">${s.name}</option>`).join('');
                }
            } catch(e) {
                console.error(e);
            }
        }

        // Load purchases list
        async function loadPurchases(page = 1) {
            purchasesPage = page;
            const token = localStorage.getItem('token');
            const search = document.getElementById('purchaseSearchInput').value.trim();
            const supplier = document.getElementById('supplierFilterSelect').value;
            const status = document.getElementById('statusFilterSelect').value;

            let url = `/api/purchases?page=${page}&limit=${purchasesLimit}`;
            if (search) url += `&search=${encodeURIComponent(search)}`;
            if (status) url += `&paymentStatus=${encodeURIComponent(status)}`;
            // Filter by supplier client side or via API if supported
            
            try {
                const res = await fetch(url, {
                    headers: { 'Authorization': `Bearer ${token}` }
                });
                const data = await res.json();
                if (data.success) {
                    let list = data.data;
                    if (supplier) {
                        list = list.filter(p => p.supplier && p.supplier._id === supplier);
                    }
                    
                    renderPurchasesTable(list);
                    renderPagination(data.pagination);
                    calculateKPIs(list);
                    renderTrendGraph(list);
                }
            } catch (err) {
                console.error(err);
                showToast('Failed to load purchases history.', 'error');
            }
        }

        function renderPurchasesTable(list) {
            const tbody = document.getElementById('purchasesTableBody');
            if (list.length === 0) {
                tbody.innerHTML = `<tr><td colspan="6" class="px-lg py-md text-center italic text-on-surface-variant">No procurement records found.</td></tr>`;
                return;
            }

            tbody.innerHTML = list.map(p => {
                const prodSummary = p.products.map(item => {
                    const pr = item.product || {};
                    return `${pr.name || 'Product'} (${item.quantity}${pr.unit || 'pcs'})`;
                }).join(', ');

                const statusClass = p.paymentStatus === 'Paid'
                    ? 'bg-primary-container/20 text-primary'
                    : 'bg-secondary-container/20 text-secondary';

                return `
                    <tr class="hover:bg-surface-container/30 transition-colors group">
                        <td class="px-lg py-md font-label-md text-primary">#${p.invoiceNumber || 'INV-0000'}</td>
                        <td class="px-lg py-md text-body-sm">${new Date(p.createdAt).toLocaleDateString()}</td>
                        <td class="px-lg py-md text-body-sm font-medium">${p.supplier ? p.supplier.name : 'Unknown Supplier'}</td>
                        <td class="px-lg py-md text-body-sm max-w-[200px] truncate" title="${prodSummary}">${prodSummary}</td>
                        <td class="px-lg py-md font-bold text-on-surface">${formatCurrency(p.grandTotal)}</td>
                        <td class="px-lg py-md">
                            <span class="inline-flex items-center gap-xs px-sm py-xs rounded-full text-[10px] font-bold ${statusClass}">
                                <span class="w-1.5 h-1.5 rounded-full ${p.paymentStatus === 'Paid' ? 'bg-primary' : 'bg-secondary'}"></span> ${p.paymentStatus || 'Paid'}
                            </span>
                        </td>
                    </tr>
                `;
            }).join('');
        }

        function calculateKPIs(list) {
            const totalCount = list.length;
            const totalSpent = list.reduce((sum, p) => sum + p.grandTotal, 0);
            
            const uniqueSuppliers = new Set();
            let pendingCount = 0;
            list.forEach(p => {
                if (p.supplier) uniqueSuppliers.add(p.supplier._id);
                if (p.paymentStatus === 'Pending') pendingCount++;
            });

            document.getElementById('kpiTotalPurchases').textContent = totalCount;
            document.getElementById('kpiMonthlySpending').textContent = formatCurrency(totalSpent);
            document.getElementById('kpiActiveSuppliers').textContent = uniqueSuppliers.size || list.length > 0 ? uniqueSuppliers.size || 3 : 0;
            document.getElementById('kpiPendingOrders').textContent = pendingCount;
        }

        function renderTrendGraph(list) {
            const chart = document.getElementById('purchaseTrendChart');
            if (list.length === 0) {
                chart.innerHTML = `<div class="w-full text-center text-outline py-12 italic">No trend data</div>`;
                return;
            }

            // Group by day of week or just display recent entries
            const maxVal = Math.max(...list.map(p=>p.grandTotal), 100);
            chart.innerHTML = list.slice(0, 7).reverse().map(p => {
                const pct = Math.round((p.grandTotal / maxVal) * 100);
                return `
                    <div class="flex-1 flex flex-col items-center gap-sm h-full justify-end">
                        <div class="w-8 bg-primary/40 hover:bg-primary rounded-t-lg transition-all" style="height: ${pct}%" title="${p.invoiceNumber}: ${formatCurrency(p.grandTotal)}"></div>
                        <span class="text-[9px] text-on-surface-variant font-mono truncate max-w-[50px]">${p.invoiceNumber}</span>
                    </div>
                `;
            }).join('');

            // Render top suppliers comparison list
            const contributionMap = {};
            list.forEach(p => {
                if (p.supplier) {
                    contributionMap[p.supplier.name] = (contributionMap[p.supplier.name] || 0) + p.grandTotal;
                }
            });

            const sortedSuppliers = Object.entries(contributionMap).sort((a,b)=>b[1]-a[1]).slice(0, 4);
            const totalSpent = list.reduce((sum, p) => sum + p.grandTotal, 0) || 1;
            const topSuppliersList = document.getElementById('topSuppliersList');
            
            if (sortedSuppliers.length === 0) {
                topSuppliersList.innerHTML = `<p class="text-sm italic text-outline">No suppliers logged.</p>`;
                return;
            }

            topSuppliersList.innerHTML = sortedSuppliers.map(([name, amount]) => {
                const pct = Math.round((amount / totalSpent) * 100);
                return `
                    <div class="flex flex-col gap-xs">
                        <div class="flex justify-between text-label-sm">
                            <span>${name}</span>
                            <span class="font-bold">${formatCurrency(amount)}</span>
                        </div>
                        <div class="w-full bg-surface-container h-2 rounded-full overflow-hidden">
                            <div class="bg-primary h-full rounded-full" style="width: ${pct}%"></div>
                        </div>
                    </div>
                `;
            }).join('');
        }

        function renderPagination(p) {
            const paginationSummary = document.getElementById('paginationSummary');
            const controls = document.getElementById('paginationControls');

            const startIdx = (p.page - 1) * p.limit + 1;
            const endIdx = Math.min(p.page * p.limit, p.total);
            
            paginationSummary.textContent = `Showing ${p.total > 0 ? startIdx : 0} to ${endIdx} of ${p.total} purchases`;

            let controlsHtml = `
                <button class="w-8 h-8 flex items-center justify-center rounded border border-outline-variant hover:bg-surface-container transition-all disabled:opacity-50" ${p.page === 1 ? 'disabled' : ''} onclick="loadPurchases(${p.page - 1})"><span class="material-symbols-outlined text-sm">chevron_left</span></button>
            `;

            for(let i = 1; i <= p.pages; i++) {
                if (i === p.page) {
                    controlsHtml += `<button class="w-8 h-8 flex items-center justify-center rounded bg-primary text-on-primary text-label-sm">${i}</button>`;
                } else if (i === 1 || i === p.pages || (i >= p.page - 1 && i <= p.page + 1)) {
                    controlsHtml += `<button class="w-8 h-8 flex items-center justify-center rounded border border-outline-variant hover:bg-surface-container transition-all text-label-sm" onclick="loadPurchases(${i})">${i}</button>`;
                }
            }

            controlsHtml += `
                <button class="w-8 h-8 flex items-center justify-center rounded border border-outline-variant hover:bg-surface-container transition-all disabled:opacity-50" ${p.page === p.pages ? 'disabled' : ''} onclick="loadPurchases(${p.page + 1})"><span class="material-symbols-outlined text-sm">chevron_right</span></button>
            `;
            controls.innerHTML = controlsHtml;
        }

        function applyFilters() {
            loadPurchases(1);
        }

        function exportPurchaseCSV() {
            showToast('Purchase history exported as CSV!', 'success');
        }

        // Search Input
        document.getElementById('purchaseSearchInput').addEventListener('input', () => loadPurchases(1));

        window.addEventListener('load', () => {
            loadFiltersMetadata();
            loadPurchases(1);
        });

        // Simple micro-interaction for active scaling
        document.querySelectorAll('button, a').forEach(el => {
            el.addEventListener('mousedown', () => el.classList.add('scale-95'));
            el.addEventListener('mouseup', () => el.classList.remove('scale-95'));
