</div>
</div>
</main>
<script>
        let editProductId = null;
        let selectedFile = null;

        // Elements
        const inputs = {
            name: document.getElementById('p_name'),
            barcode: document.getElementById('barcode'),
            sku: document.getElementById('sku'),
            category: document.getElementById('category'),
            brand: document.getElementById('brand'),
            description: document.getElementById('description'),
            purchasePrice: document.getElementById('purchase_price'),
            sellingPrice: document.getElementById('selling_price'),
            gst: document.getElementById('gst'),
            discount: document.getElementById('discount'),
            qty: document.getElementById('qty'),
            minStock: document.getElementById('min_stock'),
            unit: document.getElementById('unit'),
            location: document.getElementById('location'),
            mfd: document.getElementById('mfd'),
            expiryDate: document.getElementById('exp'),
            supplier: document.getElementById('supplier')
        };

        const previews = {
            name: document.getElementById('preview-name'),
            price: document.getElementById('preview-price'),
            stock: document.getElementById('preview-stock'),
            cat: document.getElementById('preview-category'),
            sku: document.getElementById('preview-sku'),
            sup: document.getElementById('preview-supplier'),
            loc: document.getElementById('preview-location'),
            desc: document.getElementById('preview-desc'),
            margin: document.getElementById('margin-calc'),
            statusText: document.getElementById('previewStatusText'),
            statusIndicator: document.getElementById('previewStatusIndicator'),
            img: document.getElementById('previewImage')
        };

        // File Uploader Trigger
        const uploadContainer = document.getElementById('uploadContainer');
        const fileInput = document.getElementById('productImageInput');

        uploadContainer.addEventListener('click', () => fileInput.click());
        fileInput.addEventListener('change', (e) => {
            if (e.target.files.length > 0) {
                selectedFile = e.target.files[0];
                const reader = new FileReader();
                reader.onload = (event) => {
                    previews.img.src = event.target.result;
                };
                reader.readAsDataURL(selectedFile);
                uploadContainer.querySelector('p').textContent = `Selected: ${selectedFile.name}`;
            }
        });

        // Initialize Option Dropdowns
        async function loadDropdowns() {
            const token = localStorage.getItem('token');
            try {
                // Populate categories
                const catRes = await fetch('/api/categories', { headers: { 'Authorization': `Bearer ${token}` } });
                const catData = await catRes.json();
                if (catData.success) {
                    inputs.category.innerHTML = '<option disabled selected value="">Select Category</option>';
                    catData.data.forEach(c => {
                        const opt = document.createElement('option');
                        opt.value = c._id;
                        opt.textContent = c.name;
                        inputs.category.appendChild(opt);
                    });
                }

                // Populate suppliers
                const supRes = await fetch('/api/suppliers', { headers: { 'Authorization': `Bearer ${token}` } });
                const supData = await supRes.json();
                if (supData.success) {
                    inputs.supplier.innerHTML = '<option disabled selected value="">Select Preferred Supplier</option>';
                    supData.data.forEach(s => {
                        const opt = document.createElement('option');
                        opt.value = s._id;
                        opt.textContent = s.name;
                        inputs.supplier.appendChild(opt);
                    });
                }

                // Now check if we are in EDIT mode
                checkEditMode();
            } catch (err) {
                console.error(err);
            }
        }

        // Live Preview calculator
        const updatePreview = () => {
            previews.name.textContent = inputs.name.value || "New Product Title";
            previews.price.textContent = formatCurrency(parseFloat(inputs.sellingPrice.value || 0));
            previews.stock.textContent = `${inputs.qty.value || 0} ${inputs.unit.value}`;
            
            // Category text
            const selectedCatText = inputs.category.selectedIndex >= 0 ? inputs.category.options[inputs.category.selectedIndex].text : '';
            previews.cat.textContent = selectedCatText && selectedCatText !== 'Select Category' ? selectedCatText.toUpperCase() : "CATEGORY";
            
            previews.sku.textContent = inputs.sku.value || "SKU-0000";
            
            const selectedSupText = inputs.supplier.selectedIndex >= 0 ? inputs.supplier.options[inputs.supplier.selectedIndex].text : '';
            previews.sup.textContent = selectedSupText && selectedSupText !== 'Select Preferred Supplier' ? selectedSupText : "Not Selected";
            
            previews.loc.textContent = inputs.location.value || "Unassigned";
            previews.desc.textContent = inputs.description.value ? `"${inputs.description.value.substring(0, 100)}..."` : "Enter a description on the left to see it reflected here in the product summary.";

            // Margin Calc
            const sell = parseFloat(inputs.sellingPrice.value || 0);
            const buy = parseFloat(inputs.purchasePrice.value || 0);
            if(sell > 0 && buy > 0) {
                const margin = sell - buy;
                const percent = ((margin / sell) * 100).toFixed(1);
                previews.margin.textContent = `${formatCurrency(margin)} (${percent}%)`;
            } else {
                previews.margin.textContent = "₹0.00 (0%)";
            }

            // Status Indicator
            const stock = parseInt(inputs.qty.value || 0);
            if (stock <= 0) {
                previews.statusText.textContent = 'Out of Stock';
                previews.statusText.className = 'font-label-md text-error';
                previews.statusIndicator.className = 'w-2 h-2 rounded-full bg-error animate-pulse';
            } else if (stock <= parseInt(inputs.minStock.value || 15)) {
                previews.statusText.textContent = 'Low Stock';
                previews.statusText.className = 'font-label-md text-secondary';
                previews.statusIndicator.className = 'w-2 h-2 rounded-full bg-secondary';
            } else {
                previews.statusText.textContent = 'In Stock';
                previews.statusText.className = 'font-label-md text-primary';
                previews.statusIndicator.className = 'w-2 h-2 rounded-full bg-primary';
            }
        };

        // Detect edit mode from window URL
        async function checkEditMode() {
            const pathname = window.location.pathname;
            if (pathname.includes('/products/edit/')) {
                const parts = pathname.split('/');
                editProductId = parts[parts.length - 1];
                
                // Change title and headers
                document.querySelector('h2').textContent = 'Edit Product';
                document.querySelector('p').textContent = 'Update grocery product details, prices, and stock.';
                document.getElementById('saveProductBtn').textContent = 'Update Product';

                // Fetch details
                const token = localStorage.getItem('token');
                try {
                    const res = await fetch(`/api/products/${editProductId}`, {
                        headers: { 'Authorization': `Bearer ${token}` }
                    });
                    const data = await res.json();
                    if (data.success) {
                        const p = data.data;
                        
                        inputs.name.value = p.name;
                        inputs.barcode.value = p.barcode || '';
                        inputs.sku.value = p.sku || '';
                        inputs.brand.value = p.brand || '';
                        inputs.description.value = p.description || '';
                        inputs.purchasePrice.value = p.purchasePrice;
                        inputs.sellingPrice.value = p.sellingPrice;
                        inputs.qty.value = p.stockQuantity;
                        inputs.location.value = p.location || '';
                        if (p.unit) inputs.unit.value = p.unit;
                        if (p.expiryDate) inputs.expiryDate.value = p.expiryDate.split('T')[0];

                        // Set category option selection
                        if (p.category) {
                            const catId = p.category._id || p.category;
                            inputs.category.value = catId;
                        }

                        // Set supplier
                        if (p.supplier) {
                            inputs.supplier.value = p.supplier;
                        }
                        
                        if (p.image) {
                            previews.img.src = p.image;
                        }

                        updatePreview();
                    }
                } catch (err) {
                    showToast('Failed to load product details.', 'error');
                }
            }
        }

        // Save Click
        document.getElementById('saveProductBtn').addEventListener('click', async () => {
            const token = localStorage.getItem('token');
            
            const name = inputs.name.value.trim();
            const barcode = inputs.barcode.value.trim();
            const purchasePrice = inputs.purchasePrice.value;
            const sellingPrice = inputs.sellingPrice.value;
            const category = inputs.category.value;
            const supplier = inputs.supplier.value;
            const stockQuantity = inputs.qty.value;
            
            if (!name || !barcode || !purchasePrice || !sellingPrice || !category || !stockQuantity) {
                showToast('Please fill out all required fields marked with *.', 'error');
                return;
            }

            // Use FormData for image upload support
            const formData = new FormData();
            formData.append('name', name);
            formData.append('barcode', barcode);
            formData.append('sku', inputs.sku.value.trim());
            formData.append('brand', inputs.brand.value.trim());
            formData.append('description', inputs.description.value.trim());
            formData.append('purchasePrice', purchasePrice);
            formData.append('sellingPrice', sellingPrice);
            formData.append('category', category);
            formData.append('supplier', supplier);
            formData.append('stockQuantity', stockQuantity);
            formData.append('unit', inputs.unit.value);
            formData.append('location', inputs.location.value.trim());
            
            if (inputs.expiryDate.value) {
                formData.append('expiryDate', inputs.expiryDate.value);
            }
            if (selectedFile) {
                formData.append('image', selectedFile);
            }

            const btn = document.getElementById('saveProductBtn');
            const origText = btn.textContent;
            btn.textContent = 'Saving...';
            btn.disabled = true;

            const url = editProductId ? `/api/products/${editProductId}` : '/api/products';
            
            // IMPORTANT: Since we are using Multer, we must make a PUT or POST multipart form request
            // Express router uses methodOverride or normal PUT/POST
            const method = editProductId ? 'PUT' : 'POST';

            try {
                const res = await fetch(url, {
                    method: method,
                    headers: { 'Authorization': `Bearer ${token}` },
                    body: formData
                });
                const result = await res.json();
                
                if (result.success) {
                    showToast(editProductId ? 'Product updated successfully!' : 'Product added successfully!', 'success');
                    setTimeout(() => {
                        window.location.href = '/products';
                    }, 1200);
                } else {
                    showToast(result.message || 'Error occurred.', 'error');
                }
            } catch (err) {
                showToast('Failed to save product.', 'error');
            } finally {
                btn.textContent = origText;
                btn.disabled = false;
            }
        });

        // Reset
        function resetForm() {
            Object.values(inputs).forEach(inp => {
                if (inp.tagName === 'SELECT') inp.selectedIndex = 0;
                else inp.value = '';
            });
            selectedFile = null;
            previews.img.src = 'https://images.unsplash.com/photo-1542838132-92c53300491e?auto=format&fit=crop&w=600&q=80';
            updatePreview();
        }

        // Event listeners for inputs to trigger live preview update
        Object.values(inputs).forEach(input => {
            input.addEventListener('input', updatePreview);
            input.addEventListener('change', updatePreview);
        });

        // Load dropdowns on start
        window.addEventListener('load', loadDropdowns);
    </script>
</body></html>
</body></html>
