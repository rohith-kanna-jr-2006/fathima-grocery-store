</main>
<script>
        let currentPage = 1;
        const itemsPerPage = 8;

        // Redirect + Add Product button
        const addBtn = document.querySelector('button:contains("+ Add Product")') || document.querySelectorAll('button')[2];
        if (addBtn) {
            addBtn.addEventListener('click', () => {
                window.location.href = '/products/add';
            });
        }

        // Initialize Category and Supplier Dropdowns
        async function loadDropdowns() {
            const token = localStorage.getItem('token');
            try {
                // Categories
                const catRes = await fetch('/api/categories', { headers: { 'Authorization': `Bearer ${token}` } });
                const catData = await catRes.json();
                if (catData.success) {
                    const catSelect = document.getElementById('categorySelect');
                    catData.data.forEach(c => {
                        const opt = document.createElement('option');
                        opt.value = c.name;
                        opt.textContent = c.name;
                        catSelect.appendChild(opt);
                    });
                }

                // Suppliers
                const supRes = await fetch('/api/suppliers', { headers: { 'Authorization': `Bearer ${token}` } });
                const supData = await supRes.json();
                if (supData.success) {
                    const supSelect = document.getElementById('supplierSelect');
                    supData.data.forEach(s => {
                        const opt = document.createElement('option');
                        opt.value = s._id;
                        opt.textContent = s.name;
                        supSelect.appendChild(opt);
                    });
                }
            } catch (err) {
                console.error(err);
            }
        }

        // Load Products list
        async function loadProducts(page = 1, searchQuery = '') {
            currentPage = page;
            const token = localStorage.getItem('token');
            
            const search = searchQuery || document.getElementById('productSearchInput').value.trim();
            const category = document.getElementById('categorySelect').value;
            const status = document.getElementById('availabilitySelect').value;
            const sort = document.getElementById('sortSelect').value;

            let url = `/api/products?page=${page}&limit=${itemsPerPage}`;
            if (search) url += `&search=${encodeURIComponent(search)}`;
            if (category && category !== 'Category') url += `&category=${encodeURIComponent(category)}`;
            if (status && status !== 'Availability') url += `&status=${encodeURIComponent(status)}`;
            if (sort && sort !== 'Sort By') url += `&sort=${encodeURIComponent(sort)}`;

            try {
                const res = await fetch(url, {
                    headers: { 'Authorization': `Bearer ${token}` }
                });
                const data = await res.json();
                if (data.success) {
                    renderTable(data.data);
                    renderPagination(data.pagination);
                }
            } catch (err) {
                console.error(err);
                showToast('Failed to load products list.', 'error');
            }
        }

        // Render products into table rows
        function renderTable(products) {
            const tbody = document.getElementById('productsTableBody');
            if (products.length === 0) {
                tbody.innerHTML = `<tr><td colspan="8" class="px-lg py-md text-center italic text-on-surface-variant">No products found.</td></tr>`;
                return;
            }

            tbody.innerHTML = products.map(p => {
                const statusColors = {
                    'In Stock': 'bg-primary/10 text-primary',
                    'Low Stock': 'bg-secondary/10 text-secondary',
                    'Out of Stock': 'bg-error/10 text-error'
                };
                const badgeClass = statusColors[p.status] || 'bg-outline-variant/10 text-on-surface-variant';
                const img = p.image || 'https://images.unsplash.com/photo-1542838132-92c53300491e?auto=format&fit=crop&w=200&q=80';
                
                return `
                    <tr class="hover:bg-surface-container-low/30 transition-colors cursor-default">
                        <td class="px-lg py-md">
                            <div class="flex items-center gap-md">
                                <div class="w-12 h-12 rounded-lg bg-surface-container overflow-hidden flex-shrink-0">
                                    <img class="w-full h-full object-cover" src="${img}" alt="${p.name}"/>
                                </div>
                                <div>
                                    <p class="font-label-md text-on-surface">${p.name}</p>
                                    <p class="text-xs text-on-surface-variant">${p.category ? p.category.name : 'General'}</p>
                                </div>
                            </div>
                        </td>
                        <td class="px-lg py-md font-body-sm text-on-surface-variant">${p.barcode || 'N/A'}</td>
                        <td class="px-lg py-md font-body-sm">${p.category ? p.category.name : 'General'}</td>
                        <td class="px-lg py-md font-body-sm">
                            <span class="text-on-surface-variant">${formatCurrency(p.purchasePrice)}</span> / <span class="font-bold">${formatCurrency(p.sellingPrice)}</span>
                        </td>
                        <td class="px-lg py-md font-body-sm">${p.stockQuantity} ${p.unit || 'units'}</td>
                        <td class="px-lg py-md font-body-sm">${p.expiryDate ? new Date(p.expiryDate).toLocaleDateString() : 'N/A'}</td>
                        <td class="px-lg py-md">
                            <span class="px-sm py-1 rounded-full text-[11px] font-bold uppercase tracking-wider ${badgeClass}">${p.status}</span>
                        </td>
                        <td class="px-lg py-md text-right">
                            <div class="flex justify-end gap-xs">
                                <button class="p-2 hover:bg-surface-container-high rounded-full transition-colors text-primary" onclick="window.location.href='/purchase/new?product=${p._id}'" title="Order Stock"><span class="material-symbols-outlined text-[20px]">add_shopping_cart</span></button>
                                <button class="p-2 hover:bg-surface-container-high rounded-full transition-colors text-on-surface-variant" onclick="window.location.href='/products/edit/${p._id}'" title="Edit Product"><span class="material-symbols-outlined text-[20px]">edit</span></button>
                                <button class="p-2 hover:bg-error/10 rounded-full transition-colors text-error" onclick="deleteProduct('${p._id}')" title="Delete Product"><span class="material-symbols-outlined text-[20px]">delete</span></button>
                            </div>
                        </td>
                    </tr>
                `;
            }).join('');
        }

        // Render Pagination buttons
        function renderPagination(p) {
            const paginationText = document.getElementById('paginationText');
            const controls = document.getElementById('paginationControls');

            const startIdx = (p.page - 1) * p.limit + 1;
            const endIdx = Math.min(p.page * p.limit, p.total);
            
            paginationText.textContent = `Showing ${p.total > 0 ? startIdx : 0} to ${endIdx} of ${p.total} products`;

            let controlsHtml = `
                <button class="p-2 rounded-lg border border-outline-variant/30 hover:bg-surface-container text-on-surface-variant disabled:opacity-50" ${p.page === 1 ? 'disabled' : ''} onclick="loadProducts(${p.page - 1})">
                    <span class="material-symbols-outlined">chevron_left</span>
                </button>
            `;

            for (let i = 1; i <= p.pages; i++) {
                if (i === 1 || i === p.pages || (i >= p.page - 1 && i <= p.page + 1)) {
                    const activeClass = i === p.page ? 'bg-primary text-on-primary' : 'hover:bg-surface-container text-on-surface-variant';
                    controlsHtml += `<button class="w-8 h-8 rounded-lg font-label-md flex items-center justify-center ${activeClass}" onclick="loadProducts(${i})">${i}</button>`;
                } else if (i === 2 || i === p.pages - 1) {
                    controlsHtml += `<span class="text-on-surface-variant">...</span>`;
                }
            }

            controlsHtml += `
                <button class="p-2 rounded-lg border border-outline-variant/30 hover:bg-surface-container text-on-surface-variant disabled:opacity-50" ${p.page === p.pages ? 'disabled' : ''} onclick="loadProducts(${p.page + 1})">
                    <span class="material-symbols-outlined">chevron_right</span>
                </button>
            `;
            controls.innerHTML = controlsHtml;
        }

        // Delete Product
        async function deleteProduct(id) {
            if (!confirm('Are you sure you want to delete this product? This will also remove it from inventory.')) return;
            const token = localStorage.getItem('token');
            try {
                const res = await fetch(`/api/products/${id}`, {
                    method: 'DELETE',
                    headers: { 'Authorization': `Bearer ${token}` }
                });
                const data = await res.json();
                if (data.success) {
                    showToast('Product deleted successfully!', 'success');
                    loadProducts(currentPage);
                    loadQuickStats();
                } else {
                    showToast(data.message, 'error');
                }
            } catch (err) {
                showToast('Failed to delete product.', 'error');
            }
        }

        // Load Quick Stats in Sidebar
        async function loadQuickStats() {
            const token = localStorage.getItem('token');
            try {
                const res = await fetch('/api/dashboard/stats', {
                    headers: { 'Authorization': `Bearer ${token}` }
                });
                const data = await res.json();
                if (data.success) {
                    const { cards, charts } = data.data;
                    document.getElementById('statTotalProducts').textContent = cards.totalProducts;
                    document.getElementById('statOutOfStock').textContent = cards.lowStockCount; // using low stock as indicator
                    document.getElementById('statLowStock').textContent = cards.lowStockCount;
                    document.getElementById('statInventoryValue').textContent = formatCurrency(cards.inventoryValue);

                    // Category progress bars
                    const progressContainer = document.getElementById('categoryDistributionProgress');
                    const totalProductsCount = charts.categoryDistribution.reduce((sum, c) => sum + c.count, 0);
                    
                    progressContainer.innerHTML = charts.categoryDistribution.slice(0, 3).map(c => {
                        const pct = totalProductsCount > 0 ? Math.round((c.count / totalProductsCount) * 100) : 0;
                        return `
                            <div>
                                <div class="flex justify-between text-xs mb-1">
                                    <span class="text-on-surface-variant">${c.categoryName}</span>
                                    <span class="font-bold">${pct}%</span>
                                </div>
                                <div class="w-full bg-surface-container h-1.5 rounded-full overflow-hidden">
                                    <div class="bg-primary h-full" style="width: ${pct}%"></div>
                                </div>
                            </div>
                        `;
                    }).join('');
                }
            } catch (err) {
                console.error(err);
            }
        }

        // Listen to filters
        document.getElementById('productSearchInput').addEventListener('input', () => loadProducts(1));
        document.getElementById('categorySelect').addEventListener('change', () => loadProducts(1));
        document.getElementById('supplierSelect').addEventListener('change', () => loadProducts(1));
        document.getElementById('availabilitySelect').addEventListener('change', () => loadProducts(1));
        document.getElementById('sortSelect').addEventListener('change', () => loadProducts(1));

        // Load on startup
        window.addEventListener('load', () => {
            loadDropdowns();
            // Check if there is an incoming search query in URL
            const urlParams = new URLSearchParams(window.location.search);
            const searchQ = urlParams.get('search');
            if (searchQ) {
                document.getElementById('productSearchInput').value = searchQ;
            }
            loadProducts(1);
            loadQuickStats();
        });
    </script>
</body></html>
</file>

