                    </button>
<button onclick="resetCheckout()" class="px-lg py-md rounded-xl font-label-md text-label-md text-on-surface-variant hover:bg-surface-container-high transition-all flex items-center gap-sm">
<span class="material-symbols-outlined" data-icon="refresh">refresh</span>
                        Reset
                    </button>
</div>
<div class="flex items-center gap-md">
<button id="generateBillBtn" class="px-xl py-md rounded-xl font-label-md text-label-md bg-secondary text-on-secondary hover:brightness-110 active:scale-95 transition-all flex items-center gap-sm shadow-md">
<span class="material-symbols-outlined" data-icon="print">print</span>
                        Generate Bill &amp; Print
                    </button>
<button id="completeSaleBtn" class="px-xl py-md rounded-xl font-label-md text-label-md bg-primary text-on-primary hover:brightness-110 active:scale-95 transition-all flex items-center gap-sm shadow-md shadow-primary/20">
<span class="material-symbols-outlined" data-icon="check_circle">check_circle</span>
                        Complete Sale
                    </button>
</div>
</div>
</div>
</main>
<script>
        let cartItems = [];
        let selectedProduct = null;
        let paymentMode = 'Cash';
        const invoiceNumber = `INV-${Date.now().toString().slice(-6)}`;

        // Set Date to Today
        document.getElementById('invoiceDate').value = new Date().toISOString().split('T')[0];
        document.getElementById('invoiceNumberText').textContent = invoiceNumber;
        document.getElementById('previewInvoiceNum').textContent = `INV: ${invoiceNumber}`;
        document.getElementById('previewInvoiceDate').textContent = `DATE: ${new Date().toLocaleDateString()}`;

        // Load Manager details in cashier input
        const storedUser = localStorage.getItem('user');
        if (storedUser) {
            try {
                const user = JSON.parse(storedUser);
                document.getElementById('cashierName').value = user.username === 'admin' ? 'Admin' : user.username;
                document.getElementById('previewCashier').textContent = `CASHIER: ${user.username}`;
            } catch(e){}
        }

        // Live Product Search
        const searchInput = document.getElementById('productSearchInput');
        const suggestionsDropdown = document.getElementById('suggestionsDropdown');

        searchInput.addEventListener('input', async (e) => {
            const val = e.target.value.trim();
            if (val.length < 2) {
                suggestionsDropdown.innerHTML = '';
                suggestionsDropdown.classList.add('hidden');
                return;
            }

            const token = localStorage.getItem('token');
            try {
                const res = await fetch(`/api/products?search=${encodeURIComponent(val)}&limit=5`, {
                    headers: { 'Authorization': `Bearer ${token}` }
                });
                const data = await res.json();
                if (data.success && data.data.length > 0) {
                    suggestionsDropdown.innerHTML = data.data.map(p => `
                        <div class="px-md py-sm hover:bg-primary/5 cursor-pointer border-b border-outline-variant/10 text-sm flex justify-between" onclick='selectProduct(${JSON.stringify(p).replace(/'/g, "&apos;")})'>
                            <span>${p.name} <span class="text-xs text-outline">(${p.barcode || ''})</span></span>
                            <span class="font-bold">₹${p.sellingPrice}</span>
                        </div>
                    `).join('');
                    suggestionsDropdown.classList.remove('hidden');
                } else {
                    suggestionsDropdown.innerHTML = `<div class="px-md py-sm text-sm text-outline italic">No matching products</div>`;
                    suggestionsDropdown.classList.remove('hidden');
                }
            } catch (err) {
                console.error(err);
            }
        });

        // Hide dropdown on blur
        document.addEventListener('click', (e) => {
            if (!searchInput.contains(e.target) && !suggestionsDropdown.contains(e.target)) {
                suggestionsDropdown.classList.add('hidden');
            }
        });

        // Selecting suggestion product
        window.selectProduct = function(p) {
            selectedProduct = p;
            searchInput.value = p.name;
            document.getElementById('productPrice').value = `₹ ${parseFloat(p.sellingPrice).toFixed(2)}`;
            document.getElementById('productStock').value = p.stockQuantity;
            document.getElementById('productQty').value = 1;
            document.getElementById('productQty').focus();
            suggestionsDropdown.classList.add('hidden');
        };

        // Add Product To Cart
        document.getElementById('addProductBtn').addEventListener('click', () => {
            if (!selectedProduct) {
                showToast('Please search and select a product first.', 'error');
                return;
            }

            const qty = parseInt(document.getElementById('productQty').value || 1);
            if (qty <= 0) {
                showToast('Quantity must be greater than zero.', 'error');
                return;
            }

            if (qty > selectedProduct.stockQuantity) {
                showToast(`Insufficient stock! Only ${selectedProduct.stockQuantity} units available.`, 'error');
                return;
            }

            // Check if product already in cart
            const existingIdx = cartItems.findIndex(item => item.product._id === selectedProduct._id);
            if (existingIdx >= 0) {
                const newQty = cartItems[existingIdx].quantity + qty;
                if (newQty > selectedProduct.stockQuantity) {
                    showToast(`Insufficient stock for total qty! Only ${selectedProduct.stockQuantity} units available.`, 'error');
                    return;
                }
                cartItems[existingIdx].quantity = newQty;
            } else {
                cartItems.push({
                    product: selectedProduct,
                    quantity: qty,
                    price: selectedProduct.sellingPrice,
                    gstRate: 5 // Default 5% standard GST
                });
            }

            // Clear inputs
            selectedProduct = null;
            searchInput.value = '';
            document.getElementById('productPrice').value = '₹ 0.00';
            document.getElementById('productStock').value = '0';
            document.getElementById('productQty').value = 1;

            showToast('Item added to cart.', 'success');
            calculateTotals();
        });

        function renderCart() {
            const tbody = document.getElementById('cartTableBody');
            const previewTbody = document.getElementById('previewItemsTableBody');
            
            document.getElementById('cartTitle').textContent = `ITEM LIST (${cartItems.length} ITEMS)`;

            if (cartItems.length === 0) {
                tbody.innerHTML = `<tr><td colspan="6" class="px-lg py-md text-center italic text-on-surface-variant">Your cart is empty.</td></tr>`;
                previewTbody.innerHTML = `<tr><td colspan="3" class="py-sm text-center italic opacity-55">No items added.</td></tr>`;
                return;
            }

            // Render table
            tbody.innerHTML = cartItems.map((item, idx) => {
                const sub = item.price * item.quantity;
                const gstAmount = sub * (item.gstRate / 100);
                const netSub = sub + gstAmount;

                return `
                    <tr class="hover:bg-surface-container-low transition-colors">
                        <td class="px-lg py-md">
                            <p class="font-body-sm text-body-sm font-medium text-on-surface">${item.product.name}</p>
                            <p class="text-[11px] text-on-surface-variant">Barcode: ${item.product.barcode || 'N/A'}</p>
                        </td>
                        <td class="px-lg py-md text-center font-body-sm text-body-sm">${item.quantity}</td>
                        <td class="px-lg py-md text-right font-body-sm text-body-sm">${formatCurrency(item.price)}</td>
                        <td class="px-lg py-md text-right font-body-sm text-body-sm">${formatCurrency(gstAmount)}</td>
                        <td class="px-lg py-md text-right font-body-sm text-body-sm font-bold">${formatCurrency(netSub)}</td>
                        <td class="px-lg py-md text-center">
                            <button class="material-symbols-outlined text-[18px] text-error hover:bg-error/10 rounded p-1" onclick="removeFromCart(${idx})">delete</button>
                        </td>
                    </tr>
                `;
            }).join('');

            // Render Printed Invoice rows
            previewTbody.innerHTML = cartItems.map(item => {
                const sub = item.price * item.quantity;
                const gstAmount = sub * (item.gstRate / 100);
                const netSub = sub + gstAmount;
                return `
                    <tr>
                        <td class="py-xs">${item.product.name}</td>
                        <td class="text-center">${item.quantity}</td>
                        <td class="text-right">${formatCurrency(netSub)}</td>
                    </tr>
                `;
            }).join('');
        }

        window.removeFromCart = function(idx) {
            cartItems.splice(idx, 1);
            showToast('Item removed from cart.', 'success');
            calculateTotals();
        };

        // Calculate checkout math
        function calculateTotals() {
            let subtotal = 0;
            let gstTotal = 0;

            cartItems.forEach(item => {
                const sub = item.price * item.quantity;
                subtotal += sub;
                gstTotal += sub * (item.gstRate / 100);
            });

            // Discount 5%
            const discountPercent = 5;
            const discountAmount = subtotal * (discountPercent / 100);
            const grandTotal = subtotal - discountAmount + gstTotal;

            // Recalculate Change return
            const cashReceived = parseFloat(document.getElementById('amountReceived').value || 0);
            let change = 0;
            if (cashReceived > grandTotal) {
                change = cashReceived - grandTotal;
            }

            // Populate DOM Order Summary
            document.getElementById('summaryTotalItems').textContent = cartItems.length;
            document.getElementById('summarySubtotal').textContent = formatCurrency(subtotal);
            document.getElementById('summaryDiscount').textContent = `- ${formatCurrency(discountAmount)}`;
            document.getElementById('summaryGst').textContent = formatCurrency(gstTotal);
            document.getElementById('summaryGrandTotal').textContent = formatCurrency(grandTotal);
            document.getElementById('summaryAmountPaid').textContent = formatCurrency(cashReceived);
            document.getElementById('summaryChange').textContent = formatCurrency(change);

            // Populate return inputs
            document.getElementById('balanceToReturn').value = formatCurrency(change);

            // Live Preview details
            document.getElementById('previewSubtotal').textContent = formatCurrency(subtotal);
            document.getElementById('previewGrandTotal').textContent = formatCurrency(grandTotal);

            renderCart();
        }

        // Cash Received input listener
        document.getElementById('amountReceived').addEventListener('input', calculateTotals);

        // Customer details live binding
        document.getElementById('customerName').addEventListener('input', (e) => {
            document.getElementById('previewCustomer').textContent = `CUSTOMER: ${e.target.value || 'Walk-in'}`;
        });

        // Payment Method selectors
        document.getElementById('payModeCash').addEventListener('click', () => {
            paymentMode = 'Cash';
            updatePaymentTabs('payModeCash');
        });
        document.getElementById('payModeUPI').addEventListener('click', () => {
            paymentMode = 'UPI';
            updatePaymentTabs('payModeUPI');
        });
        document.getElementById('payModeCard').addEventListener('click', () => {
            paymentMode = 'Card';
            updatePaymentTabs('payModeCard');
        });

        function updatePaymentTabs(activeId) {
            const ids = ['payModeCash', 'payModeUPI', 'payModeCard'];
            ids.forEach(id => {
                const btn = document.getElementById(id);
                if (id === activeId) {
                    btn.className = 'flex-1 border-2 border-primary bg-primary/5 p-sm rounded-lg flex flex-col items-center gap-xs';
                    btn.querySelector('span:first-child').className = 'material-symbols-outlined text-primary';
                    btn.querySelector('span:last-child').className = 'text-[10px] font-bold text-primary';
                } else {
                    btn.className = 'flex-1 border border-outline-variant p-sm rounded-lg flex flex-col items-center gap-xs hover:border-primary/50';
                    btn.querySelector('span:first-child').className = 'material-symbols-outlined text-on-surface-variant';
                    btn.querySelector('span:last-child').className = 'text-[10px] font-bold text-on-surface-variant';
                }
            });
        }

        // Complete Checkout Submit
        async function submitCheckout(status = 'Paid') {
            if (cartItems.length === 0) {
                showToast('Cannot complete checkout: Cart is empty.', 'error');
                return;
            }

            const token = localStorage.getItem('token');
            const customerName = document.getElementById('customerName').value.trim();
            const customerPhone = document.getElementById('customerPhone').value.trim();
            const customerEmail = document.getElementById('customerEmail').value.trim();
            const amountReceivedValue = parseFloat(document.getElementById('amountReceived').value || 0);

            // Structure body
            const items = cartItems.map(item => ({
                product: item.product._id,
                quantity: item.quantity,
                price: item.price
            }));

            // Math
            let sub = 0;
            let gst = 0;
            cartItems.forEach(item => {
                sub += item.price * item.quantity;
                gst += (item.price * item.quantity) * (item.gstRate / 100);
            });
            const discount = sub * 0.05;
            const totalAmount = sub - discount + gst;

            const body = {
                invoiceNumber,
                customerName: customerName || 'Walk-in Customer',
                customerPhone,
                paymentMode,
                status: document.getElementById('paymentStatusSelect').value,
                items,
                totalAmount
            };

            const btn = document.getElementById('completeSaleBtn');
            const orig = btn.innerHTML;
            btn.innerHTML = '<span class="material-symbols-outlined animate-spin">sync</span> Checking...';
            btn.disabled = true;

            try {
                const res = await fetch('/api/sales', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'Authorization': `Bearer ${token}`
                    },
                    body: JSON.stringify(body)
                });
                const result = await res.json();
                
                if (result.success) {
                    showToast('Sale checkout complete!', 'success');
                    setTimeout(() => {
                        window.location.href = '/sales';
                    }, 1200);
                } else {
                    showToast(result.message || 'Checkout failed.', 'error');
                }
            } catch (err) {
                showToast('Network error, failed to checkout.', 'error');
            } finally {
                btn.innerHTML = orig;
                btn.disabled = false;
            }
        }

        document.getElementById('completeSaleBtn').addEventListener('click', () => submitCheckout('Paid'));
        document.getElementById('generateBillBtn').addEventListener('click', async () => {
            // First submit to DB
            await submitCheckout('Paid');
            // Then trigger standard print
            window.print();
        });

        // Reset checkout
        window.resetCheckout = function() {
            cartItems = [];
            selectedProduct = null;
            document.getElementById('customerName').value = 'Walk-in Customer';
            document.getElementById('customerPhone').value = '';
            document.getElementById('customerEmail').value = '';
            document.getElementById('productSearchInput').value = '';
            document.getElementById('productPrice').value = '₹ 0.00';
            document.getElementById('productStock').value = '0';
            document.getElementById('productQty').value = 1;
            document.getElementById('amountReceived').value = 0;
            calculateTotals();
        };
    </script>
</body></html>
