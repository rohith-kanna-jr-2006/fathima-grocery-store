<!-- Micro-interaction Scripts -->
<script>
        // Micro-interaction for cards
        document.querySelectorAll('.glass-card').forEach(card => {
            card.addEventListener('mouseenter', () => {
                card.style.transform = 'translateY(-4px)';
                card.style.transition = 'transform 0.3s cubic-bezier(0.34, 1.56, 0.64, 1)';
            });
            card.addEventListener('mouseleave', () => {
                card.style.transform = 'translateY(0px)';
            });
        });

        // Fetch Live Dashboard Data from API
        async function loadDashboardData() {
            const token = localStorage.getItem('token');
            try {
                const res = await fetch('/api/dashboard/stats', {
                    headers: { 'Authorization': `Bearer ${token}` }
                });
                const data = await res.json();
                if (!data.success) {
                    showToast('Failed to load dashboard statistics.', 'error');
                    return;
                }

                const { cards, lists, charts } = data.data;

                // 1. Update KPI Cards
                document.querySelector('h3:contains("1,482"), h3.text-headline-lg').textContent = cards.totalProducts;
                
                // Update Inventory Value Card
                const cardHeaders = document.querySelectorAll('p.font-label-md');
                cardHeaders.forEach(header => {
                    const h3 = header.nextElementSibling;
                    if (!h3) return;
                    
                    if (header.textContent.includes('Stock Value')) {
                        h3.textContent = formatCurrency(cards.inventoryValue);
                    } else if (header.textContent.includes('Daily Sales')) {
                        h3.textContent = formatCurrency(cards.todaySales);
                    } else if (header.textContent.includes('Low Stock Items')) {
                        h3.textContent = cards.lowStockCount;
                    } else if (header.textContent.includes('Total Products')) {
                        h3.textContent = cards.totalProducts;
                    }
                });

                // 2. Render Urgent Refills List
                const urgentRefillsContainer = document.querySelector('.space-y-md');
                if (urgentRefillsContainer) {
                    if (!lists.lowStockList || lists.lowStockList.length === 0) {
                        urgentRefillsContainer.innerHTML = '<p class="text-on-surface-variant font-body-sm italic text-center py-md">No items low in stock!</p>';
                    } else {
                        urgentRefillsContainer.innerHTML = lists.lowStockList.map(item => {
                            const prod = item.product || { name: 'Unknown Item', image: '', unit: 'unit' };
                            const imgUrl = prod.image || 'https://images.unsplash.com/photo-1542838132-92c53300491e?auto=format&fit=crop&w=200&q=80';
                            return `
                                <div class="flex items-center justify-between p-sm rounded-lg hover:bg-surface-container transition-colors">
                                    <div class="flex items-center gap-md">
                                        <img class="w-10 h-10 rounded-lg object-cover" src="${imgUrl}" alt="${prod.name}"/>
                                        <div>
                                            <p class="font-label-md text-label-md">${prod.name}</p>
                                            <p class="font-body-sm text-body-sm text-error">${item.stockQuantity} ${prod.unit || 'units'} left</p>
                                        </div>
                                    </div>
                                    <button class="p-xs bg-surface-container rounded-lg text-primary hover:bg-primary-container hover:text-on-primary-container" onclick="window.location.href='/purchase/new?product=${item.product._id}'">
                                        <span class="material-symbols-outlined">add_shopping_cart</span>
                                    </button>
                                </div>
                            `;
                        }).join('');
                    }
                }

                // 3. Draw Weekly Sales Overview SVG Line Chart
                const svgElement = document.querySelector('svg');
                const weekdaysLabelsContainer = document.querySelector('svg').parentElement.nextElementSibling;
                
                if (svgElement && charts.weeklySalesData) {
                    const salesData = charts.weeklySalesData;
                    const maxVal = Math.max(...salesData.map(d => d.sales), 1000);
                    
                    // Update Y-Axis labels
                    const yAxisLabels = svgElement.parentElement.firstElementChild;
                    if (yAxisLabels && yAxisLabels.children.length >= 5) {
                        yAxisLabels.children[0].textContent = formatCurrency(maxVal);
                        yAxisLabels.children[1].textContent = formatCurrency(maxVal * 0.75);
                        yAxisLabels.children[2].textContent = formatCurrency(maxVal * 0.5);
                        yAxisLabels.children[3].textContent = formatCurrency(maxVal * 0.25);
                        yAxisLabels.children[4].textContent = '0';
                    }

                    // Compute points
                    const points = [];
                    const width = 800;
                    const height = 160; // leave padding
                    const padding = 20;

                    salesData.forEach((d, idx) => {
                        const x = idx * (width / 6);
                        const ratio = d.sales / maxVal;
                        const y = height - (ratio * (height - padding)) + padding;
                        points.push({ x, y, day: d.day });
                    });

                    // Build path
                    let dPath = `M ${points[0].x} ${points[0].y}`;
                    for (let i = 1; i < points.length; i++) {
                        dPath += ` L ${points[i].x} ${points[i].y}`;
                    }

                    // Replace path
                    const pathNode = svgElement.querySelector('path');
                    if (pathNode) {
                        pathNode.setAttribute('d', dPath);
                    }

                    // Replace circle elements
                    // Clear existing circles
                    const circles = svgElement.querySelectorAll('circle');
                    circles.forEach(c => c.remove());

                    // Add new circles
                    points.forEach(pt => {
                        const circle = document.createElementNS('http://www.w3.org/2000/svg', 'circle');
                        circle.setAttribute('cx', pt.x);
                        circle.setAttribute('cy', pt.y);
                        circle.setAttribute('r', '6');
                        circle.setAttribute('fill', '#006b2c');
                        circle.setAttribute('stroke', '#ffffff');
                        circle.setAttribute('stroke-width', '2');
                        circle.innerHTML = `<title>${pt.day}: ${formatCurrency(pt.sales)}</title>`;
                        svgElement.appendChild(circle);
                    });

                    // Update weekday labels
                    if (weekdaysLabelsContainer) {
                        weekdaysLabelsContainer.innerHTML = points.map(pt => `<span>${pt.day}</span>`).join('');
                    }
                }

                // 4. Update Category Distribution Text
                const categoryLegend = document.querySelector('.col-span-12.lg:col-span-4 .flex.flex-col.gap-sm');
                const mainPercentLabel = document.querySelector('.col-span-12.lg:col-span-4 span.font-headline-lg');
                
                if (categoryLegend && charts.categoryDistribution) {
                    const catDist = charts.categoryDistribution;
                    const totalProductsCount = catDist.reduce((sum, c) => sum + c.count, 0);

                    if (catDist.length > 0) {
                        const mainPct = Math.round((catDist[0].count / totalProductsCount) * 100);
                        if (mainPercentLabel) {
                            mainPercentLabel.textContent = `${mainPct}%`;
                            mainPercentLabel.nextElementSibling.textContent = catDist[0].categoryName;
                        }

                        // Colors palette for UI
                        const colors = ['bg-primary', 'bg-secondary', 'bg-tertiary-container', 'bg-error', 'bg-outline-variant'];
                        
                        categoryLegend.innerHTML = catDist.slice(0, 5).map((cat, idx) => {
                            const pct = Math.round((cat.count / totalProductsCount) * 100);
                            const color = colors[idx % colors.length];
                            return `
                                <div class="flex justify-between items-center">
                                    <div class="flex items-center gap-xs">
                                        <div class="w-3 h-3 rounded-full ${color}"></div>
                                        <span class="font-body-sm text-body-sm">${cat.categoryName}</span>
                                    </div>
                                    <span class="font-label-md text-label-md">${pct}%</span>
                                </div>
                            `;
                        }).join('');
                    }
                }

            } catch (err) {
                console.error(err);
                showToast('Failed to load live statistics.', 'error');
            }
        }

        // jQuery-like helper for checking text contains
        HTMLElement.prototype.contains = function(text) {
            return this.textContent.indexOf(text) !== -1;
        };
        
        // Polyfill jQuery contains selector in pure JS
        window.addEventListener('load', () => {
            // Find Elements containing text if needed
            loadDashboardData();
        });
    </script>
</body></html>
</file>

