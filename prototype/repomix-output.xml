<script>
        let loadedProducts = [];
        let selectedProduct = null;
        let activeAdjType = 'Increase'; // Increase or Decrease

        // Set Date to Today
        document.getElementById('adjustmentDate').value = new Date().toISOString().split('T')[0];

        // Load Manager username in profile context
        const storedUser = localStorage.getItem('user');
        if (storedUser) {
            try {
                const user = JSON.parse(storedUser);
                const name = user.username === 'admin' ? 'Admin' : user.username;
                document.getElementById('managerUserName').textContent = name;
                document.getElementById('cashierAvatarText').textContent = name.slice(0,2).toUpperCase();
                document.getElementById('cashierRoleText').textContent = `${name} (Store Manager)`;
            } catch(e){}
        }

        // Fetch products and inventory details
        async function loadProductsMetadata() {
            const token = localStorage.getItem('token');
            try {
                const res = await fetch('/api/products?limit=200', {
                    headers: { 'Authorization': `Bearer ${token}` }
                });
                const data = await res.json();
                if (data.success) {
                    loadedProducts = data.data;
                    const select = document.getElementById('productSelect');
                    select.innerHTML = loadedProducts.map(p => `<option value="${p._id}">${p.name}</option>`).join('');
                    
                    // Trigger initial product details
                    if (loadedProducts.length > 0) {
                        loadProductInventory(loadedProducts[0]._id);
                    }
                }
            } catch (err) {
                console.error(err);
                showToast('Failed to load products list.', 'error');
            }
        }

        async function loadProductInventory(productId) {
            const token = localStorage.getItem('token');
            try {
                const res = await fetch(`/api/inventory`, {
                    headers: { 'Authorization': `Bearer ${token}` }
                });
                const data = await res.json();
                if (data.success) {
                    const inv = data.data.find(i => i.product && i.product._id === productId);
                    const prod = loadedProducts.find(p => p._id === productId);
                    if (prod) {
                        selectedProduct = prod;
                        const stockQty = inv ? inv.stockQuantity : 0;
                        document.getElementById('currentStockText').innerHTML = `${stockQty} <span class="text-body-sm font-normal text-on-surface-variant">${prod.unit || 'Units'}</span>`;
                        
                        // Update preview details
                        document.getElementById('sidebarProductName').textContent = prod.name;
                        document.getElementById('sidebarProductSKU').textContent = `SKU: ${prod.sku || 'N/A'}`;
                        document.getElementById('sidebarProductCategory').textContent = prod.category ? (prod.category.name || prod.category) : 'General';
                        document.getElementById('sidebarProductPrice').textContent = formatCurrency(prod.sellingPrice);
                        document.getElementById('sidebarProductStatus').textContent = inv ? inv.status : 'In Stock';

                        // Set image preview if present
                        if (prod.image) {
                            document.getElementById('sidebarProductImage').style.backgroundImage = `url('${prod.image}')`;
                            document.getElementById('sidebarProductImage').innerHTML = '';
                        } else {
                            document.getElementById('sidebarProductImage').style.backgroundImage = 'none';
                            document.getElementById('sidebarProductImage').innerHTML = '<span class="material-symbols-outlined">image</span>';
                        }
                    }
                }
            } catch (err) {
                console.error(err);
            }
        }

        // Dropdown selection change
        document.getElementById('productSelect').addEventListener('change', (e) => {
            loadProductInventory(e.target.value);
        });

        // Load Stock adjustments history logs
        async function loadAdjustmentHistory() {
            const token = localStorage.getItem('token');
            try {
                const res = await fetch('/api/inventory/adjustments/history', {
                    headers: { 'Authorization': `Bearer ${token}` }
                });
                const data = await res.json();
                if (data.success) {
                    renderAdjustmentLogs(data.data);
                }
            } catch(e) {
                console.error(e);
            }
        }

        function renderAdjustmentLogs(logs) {
            const tbody = document.getElementById('adjustmentsLogTableBody');
            if (!logs || logs.length === 0) {
                tbody.innerHTML = `<tr><td colspan="5" class="p-md text-center italic text-on-surface-variant">No stock adjustment entries found.</td></tr>`;
                return;
            }

            tbody.innerHTML = logs.slice(0, 8).map(log => {
                const dateStr = new Date(log.createdAt).toLocaleDateString();
                const sign = log.adjustmentQuantity > 0 ? '+' : '';
                const color = log.adjustmentQuantity > 0 ? 'text-primary' : 'text-error';
                
                return `
                    <tr class="hover:bg-surface-container/30 transition-colors">
                        <td class="p-md font-body-sm font-medium text-on-surface">${log.product ? log.product.name : 'Unknown Product'}</td>
                        <td class="p-md text-body-sm">${dateStr}</td>
                        <td class="p-md font-bold text-right ${color}">${sign}${log.adjustmentQuantity}</td>
                        <td class="p-md text-body-sm">${log.adjustmentType}</td>
                        <td class="p-md text-body-sm text-on-surface-variant">${log.reason || 'Manual Check'}</td>
                    </tr>
                `;
            }).join('');
        }

        function toggleType(type) {
            activeAdjType = type;
            const incBtn = document.getElementById('btn-increase');
            const decBtn = document.getElementById('btn-decrease');
            
            if (type === 'Increase') {
                incBtn.classList.add('bg-primary', 'text-on-primary', 'shadow-sm');
                incBtn.classList.remove('text-on-surface-variant');
                decBtn.classList.remove('bg-error', 'text-on-error', 'shadow-sm');
                decBtn.classList.add('text-on-surface-variant');
                
                // Set default increase reason
                document.getElementById('reasonSelect').value = 'Stock Received';
            } else {
                decBtn.classList.add('bg-error', 'text-on-error', 'shadow-sm');
                decBtn.classList.remove('text-on-surface-variant');
                incBtn.classList.remove('bg-primary', 'text-on-primary', 'shadow-sm');
                incBtn.classList.add('text-on-surface-variant');
                
                // Set default decrease reason
                document.getElementById('reasonSelect').value = 'Damaged/Spoiled Goods';
            }
        }

        // Submit Adjustment Form
        async function saveStockAdjustment() {
            if (!selectedProduct) {
                showToast('Please select a product.', 'error');
                return;
            }

            const token = localStorage.getItem('token');
            const qtyVal = parseInt(document.getElementById('adjustQuantity').value);
            const reasonVal = document.getElementById('reasonSelect').value;
            const notesVal = document.getElementById('adjustmentNotes').value.trim();

            if (isNaN(qtyVal) || qtyVal <= 0) {
                showToast('Adjustment quantity must be greater than zero.', 'error');
                return;
            }

            // Reason field combines reason selection with user notes
            const finalReason = notesVal ? `${reasonVal}: ${notesVal}` : reasonVal;

            const body = {
                productId: selectedProduct._id,
                adjustmentQuantity: qtyVal,
                adjustmentType: activeAdjType,
                reason: finalReason
            };

            try {
                const res = await fetch('/api/inventory/adjustments', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'Authorization': `Bearer ${token}`
                    },
                    body: JSON.stringify(body)
                });
                const result = await res.json();
                if (result.success) {
                    document.getElementById('toastText').textContent = 'Stock adjustment logged successfully!';
                    showToastAlert();
                    resetAdjustmentForm();
                    
                    // Reload stock status and table
                    loadProductInventory(selectedProduct._id);
                    loadAdjustmentHistory();
                } else {
                    showToast(result.message || 'Failed to apply adjustment.', 'error');
                }
            } catch(e) {
                showToast('Network error, failed to adjust stock.', 'error');
            }
        }

        function resetAdjustmentForm() {
            document.getElementById('adjustQuantity').value = '';
            document.getElementById('adjustmentNotes').value = '';
            toggleType('Increase');
        }

        function showToastAlert() {
            const toast = document.getElementById('toast');
            toast.classList.remove('translate-y-32');
            setTimeout(() => { hideToast(); }, 4000);
        }

        function hideToast() {
            const toast = document.getElementById('toast');
            toast.classList.add('translate-y-32');
        }

        window.addEventListener('load', () => {
            loadProductsMetadata();
            loadAdjustmentHistory();
        });
    </script>
</body></html>
</body></html>
</file>

