  </main>
  
  <script>
    let categoriesList = [];

    // Load all categories from API
    async function loadCategories() {
      const token = localStorage.getItem('token');
      try {
        const res = await fetch('/api/categories', {
          headers: { 'Authorization': `Bearer ${token}` }
        });
        const data = await res.json();
        if (data.success) {
          categoriesList = data.data;
          renderUI();
        }
      } catch (err) {
        console.error(err);
        showToast('Failed to load categories.', 'error');
      }
    }

    // Render category tables, analytics, lists
    function renderUI() {
      const tbody = document.getElementById('categoriesTableBody');
      const searchVal = document.getElementById('tableSearchInput').value.toLowerCase();
      
      const filtered = categoriesList.filter(c => 
        c.name.toLowerCase().includes(searchVal) || 
        (c.description && c.description.toLowerCase().includes(searchVal))
      );

      // 1. Populate Table
      tbody.innerHTML = filtered.map(c => {
        const icon = getCategoryIconName(c.name);
        const statusClass = c.status === 'Active' 
          ? 'bg-primary-fixed text-on-primary-fixed' 
          : 'bg-error-container text-on-error-container';
        
        return `
          <tr class="hover:bg-surface-container-low transition-colors group">
            <td class="px-lg py-md">
              <div class="w-8 h-8 rounded-lg bg-primary/10 flex items-center justify-center text-primary">
                <span class="material-symbols-outlined text-[20px]">${icon}</span>
              </div>
            </td>
            <td class="px-lg py-md font-medium">${c.name}</td>
            <td class="px-lg py-md text-body-sm text-on-surface-variant max-w-xs truncate">${c.description || 'No description'}</td>
            <td class="px-lg py-md">
              <span class="px-2 py-1 text-[10px] font-bold rounded-full uppercase ${statusClass}">${c.status}</span>
            </td>
            <td class="px-lg py-md text-sm text-outline">${new Date(c.createdAt).toLocaleDateString()}</td>
            <td class="px-lg py-md">
              <div class="flex items-center gap-xs opacity-0 group-hover:opacity-100 transition-opacity">
                <button class="p-1 hover:text-primary" onclick="editCategory('${c._id}')"><span class="material-symbols-outlined text-[18px]">edit</span></button>
                <button class="p-1 hover:text-error" onclick="deleteCategory('${c._id}')"><span class="material-symbols-outlined text-[18px]">delete</span></button>
              </div>
            </td>
          </tr>
        `;
      }).join('');

      // 2. Analytics Counts
      const total = categoriesList.length;
      const active = categoriesList.filter(c => c.status === 'Active').length;
      const inactive = total - active;

      document.getElementById('countTotal').textContent = total;
      document.getElementById('countActive').textContent = active;
      document.getElementById('countInactive').textContent = inactive;
      document.getElementById('tablePaginationText').textContent = `Showing ${filtered.length} of ${total} categories`;

      // 3. Render Recent Categories list
      const sortedByDate = [...categoriesList].sort((a,b) => new Date(b.createdAt) - new Date(a.createdAt));
      const recentContainer = document.getElementById('recentCategoriesList');
      recentContainer.innerHTML = sortedByDate.slice(0, 3).map(c => {
        const icon = getCategoryIconName(c.name);
        return `
          <div class="flex items-center gap-md p-sm hover:bg-surface-container rounded-lg transition-colors cursor-pointer border-b border-surface-container pb-md last:border-0" onclick="editCategory('${c._id}')">
            <div class="w-10 h-10 rounded-lg bg-surface-container-high flex items-center justify-center">
              <span class="material-symbols-outlined text-primary">${icon}</span>
            </div>
            <div class="flex-1">
              <p class="font-label-md text-label-md">${c.name}</p>
              <p class="text-[11px] text-outline">${new Date(c.createdAt).toLocaleDateString()}</p>
            </div>
            <span class="material-symbols-outlined text-outline">chevron_right</span>
          </div>
        `;
      }).join('');
    }

    // Helper to get matching icons
    function getCategoryIconName(name) {
      const lower = name.toLowerCase();
      if (lower.includes('fruit') || lower.includes('produce') || lower.includes('vegetable')) return 'nutrition';
      if (lower.includes('dairy') || lower.includes('milk') || lower.includes('egg')) return 'egg';
      if (lower.includes('bakery') || lower.includes('bread')) return 'bakery_dining';
      if (lower.includes('beverage') || lower.includes('soda') || lower.includes('juice') || lower.includes('tea') || lower.includes('coffee')) return 'water_drop';
      if (lower.includes('frozen') || lower.includes('ice cream')) return 'icecream';
      if (lower.includes('oil')) return 'oil_barrel';
      return 'category';
    }

    // Delete Category
    async function deleteCategory(id) {
      if (!confirm('Are you sure you want to delete this category?')) return;
      const token = localStorage.getItem('token');
      try {
        const res = await fetch(`/api/categories/${id}`, {
          method: 'DELETE',
          headers: { 'Authorization': `Bearer ${token}` }
        });
        const data = await res.json();
        if (data.success) {
          showToast('Category deleted successfully!', 'success');
          loadCategories();
        } else {
          showToast(data.message, 'error');
        }
      } catch (err) {
        showToast('Network error, failed to delete.', 'error');
      }
    }

    // Edit Category (fills form)
    let editingId = null;
    function editCategory(id) {
      const c = categoriesList.find(item => item._id === id);
      if (!c) return;
      
      editingId = id;
      document.getElementById('categoryName').value = c.name;
      document.getElementById('categoryDesc').value = c.description || '';
      document.getElementById('categoryStatus').checked = c.status === 'Active';
      document.getElementById('saveCategoryBtn').textContent = 'Update Category';
      
      // Update preview card
      document.getElementById('previewName').textContent = c.name;
      document.getElementById('previewDesc').textContent = c.description || 'Describe the type of products in this category...';
      document.getElementById('previewStatus').textContent = c.status.toUpperCase();
      document.getElementById('previewIcon').textContent = getCategoryIconName(c.name);
      
      window.scrollTo({ top: 0, behavior: 'smooth' });
    }

    // Form inputs bind to preview
    document.getElementById('categoryName').addEventListener('input', (e) => {
      document.getElementById('previewName').textContent = e.target.value || 'Fresh Fruits';
      document.getElementById('previewIcon').textContent = getCategoryIconName(e.target.value);
    });
    
    document.getElementById('categoryDesc').addEventListener('input', (e) => {
      document.getElementById('previewDesc').textContent = e.target.value || 'Describe the type of products in this category...';
    });

    document.getElementById('categoryStatus').addEventListener('change', (e) => {
      document.getElementById('previewStatus').textContent = e.target.checked ? 'ACTIVE' : 'INACTIVE';
    });

    // Save Button Click
    document.getElementById('saveCategoryBtn').addEventListener('click', async () => {
      const name = document.getElementById('categoryName').value.trim();
      const description = document.getElementById('categoryDesc').value.trim();
      const status = document.getElementById('categoryStatus').checked ? 'Active' : 'Inactive';
      const token = localStorage.getItem('token');

      if (!name) {
        showToast('Category name is required.', 'error');
        return;
      }

      const body = { name, description, status };
      const url = editingId ? `/api/categories/${editingId}` : '/api/categories';
      const method = editingId ? 'PUT' : 'POST';

      try {
        const res = await fetch(url, {
          method,
          headers: {
            'Content-Type': 'application/json',
            'Authorization': `Bearer ${token}`
          },
          body: JSON.stringify(body)
        });
        const data = await res.json();
        
        if (data.success) {
          showToast(editingId ? 'Category updated!' : 'Category added!', 'success');
          resetForm();
          loadCategories();
        } else {
          showToast(data.message || 'Error occurred.', 'error');
        }
      } catch (err) {
        showToast('Network error, failed to save.', 'error');
      }
    });

    // Reset Form
    function resetForm() {
      editingId = null;
      document.getElementById('categoryName').value = '';
      document.getElementById('categoryDesc').value = '';
      document.getElementById('categoryStatus').checked = true;
      document.getElementById('saveCategoryBtn').textContent = 'Save Category';

      document.getElementById('previewName').textContent = 'Fresh Fruits';
      document.getElementById('previewDesc').textContent = 'Describe the type of products in this category...';
      document.getElementById('previewStatus').textContent = 'ACTIVE';
      document.getElementById('previewIcon').textContent = 'nutrition';
    }

    document.getElementById('resetFormBtn').addEventListener('click', resetForm);
    document.getElementById('cancelFormBtn').addEventListener('click', () => {
      window.location.href = '/new-entry';
    });

    // Search bar event
    document.getElementById('tableSearchInput').addEventListener('input', renderUI);

    document.getElementById('viewAllBottomBtn').addEventListener('click', () => {
      document.getElementById('tableSearchInput').scrollIntoView({ behavior: 'smooth' });
    });

    // Load on init
    window.addEventListener('load', loadCategories);
  </script>
</body></html>
</body></html>
