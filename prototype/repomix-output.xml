<script>
        // Load selector filters dynamically
        async function loadFilterDropdowns() {
            const token = localStorage.getItem('token');
            try {
                // Categories
                const catRes = await fetch('/api/categories', { headers: { 'Authorization': `Bearer ${token}` } });
                const catData = await catRes.json();
                if (catData.success) {
                    const catSelect = document.getElementById('filterCategory');
                    if (catSelect) {
                        catSelect.innerHTML = '<option value="">All Categories</option>' + 
                            catData.data.map(c => `<option value="${c.name}">${c.name}</option>`).join('');
                    }
                }

                // Suppliers
                const supRes = await fetch('/api/suppliers', { headers: { 'Authorization': `Bearer ${token}` } });
                const supData = await supRes.json();
                if (supData.success) {
                    const supSelect = document.getElementById('filterSupplier');
                    if (supSelect) {
                        supSelect.innerHTML = '<option value="">All Suppliers</option>' + 
                            supData.data.map(s => `<option value="${s._id}">${s.name}</option>`).join('');
                    }
                }

                // Products
                const prodRes = await fetch('/api/products?limit=200', { headers: { 'Authorization': `Bearer ${token}` } });
                const prodData = await prodRes.json();
                if (prodData.success) {
                    const prodSelect = document.getElementById('filterProduct');
                    if (prodSelect) {
                        prodSelect.innerHTML = '<option value="">All Products</option>' + 
                            prodData.data.map(p => `<option value="${p.name}">${p.name}</option>`).join('');
                    }
                }
            } catch(e) {
                console.error(e);
            }
        }

        // Apply advanced filters and redirect to subpage
        function applyAdvancedFilters() {
            const type = document.getElementById('filterReportType').value;
            const days = document.getElementById('filterDateRange').value;
            const category = document.getElementById('filterCategory').value;
            const supplier = document.getElementById('filterSupplier').value;
            const product = document.getElementById('filterProduct').value;

            // Calculate start and end date
            const endDate = new Date().toISOString().split('T')[0];
            const start = new Date();
            start.setDate(start.getDate() - parseInt(days));
            const startDate = start.toISOString().split('T')[0];

            let url = `/reports/${type}?startDate=${startDate}&endDate=${endDate}`;
            if (category) url += `&category=${encodeURIComponent(category)}`;
            if (supplier) url += `&supplier=${encodeURIComponent(supplier)}`;
            if (product) url += `&product=${encodeURIComponent(product)}`;

            window.location.href = url;
        }

        function exportReportData(format) {
            alert(`Generating ${format.toUpperCase()} export containing requested data filters...`);
        }

        // Load recent reports logs
        async function loadReportLogs() {
            const token = localStorage.getItem('token');
            try {
                const res = await fetch('/api/reports/logs', {
                    headers: { 'Authorization': `Bearer ${token}` }
                });
                const data = await res.json();
                if (data.success) {
                    renderReportLogs(data.data);
                }
            } catch(e) {
                console.error(e);
            }
        }

        function renderReportLogs(logs) {
            const tbody = document.getElementById('recentReportsTableBody');
            if (!tbody) return;
            if (!logs || logs.length === 0) {
                tbody.innerHTML = `<tr><td colspan="5" class="px-lg py-md text-center italic text-on-surface-variant text-sm">No report generation entries found.</td></tr>`;
                return;
            }

            tbody.innerHTML = logs.map(log => {
                const dateStr = new Date(log.date || log.createdAt).toLocaleString();
                const filterCount = Object.keys(log.filters || {}).filter(k => log.filters[k]).length;
                const filterDesc = filterCount > 0 ? `${filterCount} filters` : 'Default';

                return `
                    <tr class="hover:bg-surface-container-low transition-colors cursor-pointer text-sm">
                        <td class="px-lg py-md">
                            <div class="flex items-center gap-sm">
                                <span class="material-symbols-outlined text-primary text-[20px]">assessment</span>
                                <span class="font-body-md font-medium text-on-surface">${log.reportType}</span>
                            </div>
                        </td>
                        <td class="px-lg py-md text-on-surface-variant">${dateStr}</td>
                        <td class="px-lg py-md text-on-surface-variant font-mono text-xs">${filterDesc}</td>
                        <td class="px-lg py-md">
                            <span class="inline-flex items-center gap-1 px-2 py-0.5 bg-primary-container/20 text-primary text-xs font-bold rounded-full">
                                <span class="w-1.5 h-1.5 rounded-full bg-primary"></span> Ready
                            </span>
                        </td>
                        <td class="px-lg py-md text-right">
                            <button onclick="window.print()" class="text-on-surface-variant hover:text-primary transition-colors">
                                <span class="material-symbols-outlined text-[18px]">print</span>
                            </button>
                        </td>
                    </tr>
                `;
            }).join('');
        }

        // Fetch quick insights
        async function loadQuickInsights() {
            const token = localStorage.getItem('token');
            try {
                const res = await fetch('/api/dashboard', {
                    headers: { 'Authorization': `Bearer ${token}` }
                });
                const data = await res.json();
                if (data.success) {
                    const stats = data.data;
                    const valEl = document.getElementById('insightStockVal');
                    if (valEl) valEl.textContent = formatCurrency(stats.inventoryValuation || 0);
                    
                    const lowEl = document.getElementById('insightLowStock');
                    if (lowEl) {
                        lowEl.textContent = `${stats.lowStockCount || 0} items low`;
                        if (stats.lowStockCount > 0) {
                            lowEl.classList.add('text-error');
                        }
                    }

                    // Best Selling
                    const topEl = document.getElementById('insightTopProduct');
                    if (topEl) {
                        if (stats.recentSales && stats.recentSales.length > 0) {
                            // Gather product sales frequencies
                            const productsMap = {};
                            stats.recentSales.forEach(s => {
                                if (s.products) {
                                    s.products.forEach(p => {
                                        if (p.product) {
                                            const name = p.product.name;
                                            productsMap[name] = (productsMap[name] || 0) + p.quantity;
                                        }
                                    });
                                }
                            });
                            const sorted = Object.keys(productsMap).sort((a,b) => productsMap[b] - productsMap[a]);
                            if (sorted.length > 0) {
                                topEl.innerHTML = `${sorted[0]} <span class="text-xs font-normal block text-primary">${productsMap[sorted[0]]} sold recently</span>`;
                            } else {
                                topEl.textContent = 'Fresh Cavendish Bananas';
                            }
                        } else {
                            topEl.textContent = 'Fresh Cavendish Bananas';
                        }
                    }
                }
            } catch(e) {
                console.error(e);
            }
        }

        window.addEventListener('load', () => {
            loadFilterDropdowns();
            loadReportLogs();
            loadQuickInsights();
        });

        // Search bar focus effect
        const searchInput = document.querySelector('input[placeholder="Search reports..."]');
        if (searchInput) {
            searchInput.addEventListener('focus', () => {
                searchInput.parentElement.classList.add('ring-2', 'ring-primary');
            });
            searchInput.addEventListener('blur', () => {
                searchInput.parentElement.classList.remove('ring-2', 'ring-primary');
            });
        }
    </script>
</body></html>
