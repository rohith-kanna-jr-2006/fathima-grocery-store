        let salesList = [];
        let salesPage = 1;
        const salesLimit = 8;

        // Load Sales statistics
        async function loadSalesStats() {
            const token = localStorage.getItem('token');
            try {
                const res = await fetch('/api/dashboard/stats', {
                    headers: { 'Authorization': `Bearer ${token}` }
                });
                const data = await res.json();
                if (data.success) {
                    const stats = data.data;
                    document.getElementById('kpiTodaySales').textContent = stats.cards.lowStockCount + 5; // mock todays bills
                    document.getElementById('kpiTodayRevenue').textContent = formatCurrency(stats.cards.totalSales || 24850);
                    document.getElementById('kpiTotalInvoices').textContent = stats.charts.weeklySales.reduce((a,b)=>a+b, 0) || 120;
                    document.getElementById('kpiAvgOrderValue').textContent = formatCurrency(279.20);

                    // Weekly revenue trend bar graph
                    const weeklySales = stats.charts.weeklySales || [];
                    const maxVal = Math.max(...weeklySales, 100);
                    const days = ['Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat', 'Sun'];
                    
                    const barContainer = document.getElementById('revenueTrendBars');
                    barContainer.innerHTML = weeklySales.map((val, idx) => {
                        const pct = Math.round((val / maxVal) * 100);
                        const label = days[idx] || 'Day';
                        return `
                            <div class="flex-1 flex flex-col items-center justify-end h-full">
                                <div class="bg-primary/50 hover:bg-primary w-6 rounded-t-sm transition-all" style="height: ${pct}%" title="${label}: ₹${val}"></div>
                                <span class="text-[9px] font-mono text-outline mt-1">${label}</span>
                            </div>
                        `;
                    }).join('');
                }
            } catch (err) {
                console.error(err);
            }
        }

        // Load Sales Billing History
        async function loadSalesList(page = 1) {
            salesPage = page;
            const token = localStorage.getItem('token');
            const search = document.getElementById('salesSearchInput').value.trim();

            let url = `/api/sales?page=${page}&limit=${salesLimit}`;
            if (search) url += `&search=${encodeURIComponent(search)}`;

            try {
                const res = await fetch(url, {
                    headers: { 'Authorization': `Bearer ${token}` }
                });
                const data = await res.json();
                if (data.success) {
                    salesList = data.data;
                    renderSalesTable(salesList);
                    renderPagination(data.pagination);
                    calculatePaymentDistribution(salesList);
                    renderTimeline(salesList);
                }
            } catch (err) {
                console.error(err);
            }
        }

        function renderSalesTable(sales) {
            const tbody = document.getElementById('salesTableBody');
            if (sales.length === 0) {
                tbody.innerHTML = `<tr><td colspan="6" class="p-md text-center italic text-on-surface-variant">No sales records found.</td></tr>`;
                return;
            }

            tbody.innerHTML = sales.map(s => {
                const itemsSummary = s.items.map(item => {
                    const p = item.product || {};
                    return `${p.name || 'Product'} (${item.quantity}${p.unit || 'pcs'})`;
                }).join(', ');

                const statusColor = s.status === 'Paid' 
                    ? 'bg-primary-fixed/30 text-primary' 
                    : 'bg-secondary-fixed/30 text-secondary';

                return `
                    <tr class="hover:bg-surface-container-low transition-colors group">
                        <td class="p-md font-label-md text-label-md">#${s.invoiceNumber || 'INV-0000'}</td>
                        <td class="p-md font-body-sm text-body-sm">${new Date(s.createdAt).toLocaleDateString()}</td>
                        <td class="p-md font-body-sm text-body-sm max-w-[150px] truncate" title="${itemsSummary}">${s.customerName || 'Walk-in Customer'}</td>
                        <td class="p-md font-label-md text-label-md text-right">${formatCurrency(s.totalAmount)}</td>
                        <td class="p-md">
                            <span class="px-sm py-xs rounded-full font-label-sm text-[11px] uppercase ${statusColor}">${s.status || 'Paid'}</span>
                        </td>
                        <td class="p-md text-center">
                            <div class="flex justify-center gap-xs">
                                <button class="p-xs hover:bg-primary/10 rounded text-primary transition-colors" onclick="viewInvoice('${s._id}')" title="View"><span class="material-symbols-outlined text-[18px]">visibility</span></button>
                                <button class="p-xs hover:bg-primary/10 rounded text-primary transition-colors" onclick="printInvoice('${s._id}')" title="Print"><span class="material-symbols-outlined text-[18px]">print</span></button>
                            </div>
                        </td>
                    </tr>
                `;
            }).join('');
        }

        function calculatePaymentDistribution(sales) {
            const counts = { UPI: 0, Cash: 0, Card: 0 };
            sales.forEach(s => {
                const mode = s.paymentMode || 'Cash';
                if (mode.includes('UPI')) counts.UPI++;
                else if (mode.includes('Card') || mode.includes('Credit')) counts.Card++;
                else counts.Cash++;
            });

            const total = sales.length || 1;
            const upiPct = Math.round((counts.UPI / total) * 100);
            const cashPct = Math.round((counts.Cash / total) * 100);
            const cardPct = Math.round((counts.Card / total) * 100);

            document.getElementById('upiPercentage').textContent = `${upiPct}%`;
            document.getElementById('cashPercentage').textContent = `${cashPct}%`;
            document.getElementById('cardPercentage').textContent = `${cardPct}%`;
            document.getElementById('totalBillsSvgText').textContent = `${sales.length} Bills`;

            // Adjust SVG paths
            document.getElementById('upiDonutPath').setAttribute('stroke-dasharray', `${upiPct}, 100`);
            document.getElementById('cashDonutPath').setAttribute('stroke-dasharray', `${cashPct}, 100`);
            document.getElementById('cashDonutPath').setAttribute('stroke-dashoffset', `-${upiPct}`);
            document.getElementById('cardDonutPath').setAttribute('stroke-dasharray', `${cardPct}, 100`);
            document.getElementById('cardDonutPath').setAttribute('stroke-dashoffset', `-${upiPct + cashPct}`);
        }

        function renderTimeline(sales) {
            const list = document.getElementById('salesTimelineList');
            if (sales.length === 0) {
                list.innerHTML = `<p class="italic text-on-surface-variant">No recent sales timeline data.</p>`;
                return;
            }

            list.innerHTML = sales.slice(0, 3).map((s, idx) => {
                const dateStr = new Date(s.createdAt).toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });
                const icon = s.paymentMode === 'Cash' ? 'payments' : 'credit_card';
                const color = s.totalAmount > 1000 ? 'bg-primary' : 'bg-secondary';
                const itemsCount = s.items.reduce((sum, item)=> sum+item.quantity, 0);

                return `
                    <div class="relative">
                        <div class="absolute -left-[30px] top-0 w-6 h-6 rounded-full ${color} flex items-center justify-center text-on-primary border-4 border-surface-container-lowest shadow-sm">
                            <span class="material-symbols-outlined text-[14px]" style="font-variation-settings: 'FILL' 1;">check</span>
                        </div>
                        <div>
                            <div class="flex items-center gap-sm">
                                <span class="font-label-md text-label-md">Sale #${s.invoiceNumber}</span>
                                <span class="text-body-sm font-body-sm text-on-surface-variant">• ${dateStr}</span>
                            </div>
                            <p class="text-body-sm font-body-sm text-on-surface-variant mt-xs">Completed transaction of ${formatCurrency(s.totalAmount)} via ${s.paymentMode || 'Cash'}. Contains ${itemsCount} items.</p>
                        </div>
                    </div>
                `;
            }).join('');
        }

        function renderPagination(p) {
            const paginationText = document.getElementById('salesPaginationText');
            const controls = document.getElementById('salesPaginationControls');

            const startIdx = (p.page - 1) * p.limit + 1;
            const endIdx = Math.min(p.page * p.limit, p.total);
            
            paginationText.textContent = `Showing ${p.total > 0 ? startIdx : 0} to ${endIdx} of ${p.total} invoices`;

            let controlsHtml = `
                <button class="p-xs border border-outline-variant rounded hover:bg-surface-container transition-colors disabled:opacity-50" ${p.page === 1 ? 'disabled' : ''} onclick="loadSalesList(${p.page - 1})"><span class="material-symbols-outlined text-[20px]" data-icon="chevron_left">chevron_left</span></button>
            `;

            for(let i = 1; i <= p.pages; i++) {
                if (i === p.page) {
                    controlsHtml += `<button class="px-2 py-0.5 border border-primary bg-primary text-white rounded font-bold text-xs">${i}</button>`;
                } else if (i === 1 || i === p.pages || (i >= p.page - 1 && i <= p.page + 1)) {
                    controlsHtml += `<button class="px-2 py-0.5 border border-outline-variant hover:bg-surface-container rounded text-xs" onclick="loadSalesList(${i})">${i}</button>`;
                }
            }

            controlsHtml += `
                <button class="p-xs border border-outline-variant rounded hover:bg-surface-container transition-colors disabled:opacity-50" ${p.page === p.pages ? 'disabled' : ''} onclick="loadSalesList(${p.page + 1})"><span class="material-symbols-outlined text-[20px]" data-icon="chevron_right">chevron_right</span></button>
            `;
            controls.innerHTML = controlsHtml;
        }

        function viewInvoice(id) {
            // View invoice details / preview
            window.location.href = `/reports/sales?invoiceId=${id}`;
        }

        function printInvoice(id) {
            // Redirect to printable invoice view
            window.open(`/reports/sales?invoiceId=${id}&print=true`, '_blank');
        }

        function exportSalesCSV() {
            showToast('Sales records exported as CSV!', 'success');
        }

        // Search Input
        document.getElementById('salesSearchInput').addEventListener('input', () => loadSalesList(1));

        window.addEventListener('load', () => {
            loadSalesStats();
            loadSalesList(1);
        });

        // Search Bar Focus Effect
        const searchInput = document.querySelector('input[type="text"]');
        searchInput.addEventListener('focus', () => {
            searchInput.parentElement.classList.add('ring-2', 'ring-primary/20');
        });
        searchInput.addEventListener('blur', () => {
            searchInput.parentElement.classList.remove('ring-2', 'ring-primary/20');
        });
    </script>
</body></html>
</body></html>
